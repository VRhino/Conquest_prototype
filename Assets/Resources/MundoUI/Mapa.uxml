<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Lo que flota sobre el mapa de mundo (paso 2 del bloque 4). El fondo deja pasar el ratón al mapa. -->
    <ui:VisualElement name="mapa" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="nombres" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement class="barra-arriba">
            <ui:Label class="titulo" text="EL MUNDO" />
            <ui:Button name="capa-nodos" class="boton-secundario" text="Nodos" />
            <ui:Button name="capa-fertilidad" class="boton-secundario" text="Fertilidad" />
            <ui:Button name="marcha-forzada" class="boton-secundario" text="Marcha forzada" />
            <ui:Button name="avisos" class="boton-secundario" text="Avisos" />
            <ui:Button name="cambiar-partida" class="boton-secundario" text="Cambiar de partida" />
            <ui:Button name="cerrar-sesion" class="boton-secundario" text="Cerrar sesión" />
        </ui:VisualElement>
        <!-- Dentro de un sitio (los interiores son los pasos 4 y 7): dónde estás y salir. -->
        <ui:VisualElement name="dentro" class="placa panel-mapa-arriba oculto">
            <ui:VisualElement class="placa-filete fila-mapa">
                <ui:Label name="dentro-texto" class="dialogo-texto" style="margin-bottom: 0; flex-grow: 1;" />
                <ui:Button name="salir" class="boton-primario" text="SALIR AL MUNDO" style="margin-top: 0; height: 36px; padding: 0 16px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Con dos o más cosas bajo el clic: elegir una. -->
        <ui:VisualElement name="lista" class="placa panel-mapa-arriba oculto">
            <ui:VisualElement class="placa-filete">
                <ui:Label name="lista-titulo" class="kicker" style="margin-top: 0;" />
                <ui:VisualElement name="lista-filas" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- La ficha de lo seleccionado, abajo a la derecha: solo las acciones que se pueden hacer. -->
        <ui:VisualElement name="ficha" class="placa ficha-mapa oculto">
            <ui:VisualElement class="placa-filete" style="padding: 14px 16px;">
                <ui:VisualElement class="fila-mapa">
                    <ui:Label name="ficha-nombre" class="dialogo-titulo" style="flex-grow: 1; margin-bottom: 2px;" />
                    <ui:Button name="ficha-cerrar" class="aviso-borrar" text="×" />
                </ui:VisualElement>
                <ui:Label name="ficha-detalle" class="ficha-valor" style="-unity-text-align: middle-left; margin-bottom: 8px;" />
                <!-- El nivel de un campamento de bandidos en tres círculos (`.bandidos-nivel`). -->
                <ui:VisualElement name="ficha-nivel" class="bandidos-nivel oculto" />
                <ui:VisualElement name="ficha-datos" />
                <ui:VisualElement name="ficha-acciones" style="margin-top: 8px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="ayuda" picking-mode="Ignore" style="position: absolute; left: 12px; bottom: 10px; padding: 4px 10px; font-size: 13px; color: rgb(237, 224, 196); background-color: rgba(11, 8, 5, 0.72); border-radius: 3px; -unity-text-align: middle-left;"
                  text="Clic en el suelo: marchar · Clic en algo: elegirlo · Arrastrar o WASD: girar e inclinar · Rueda: zoom · F2: diagnóstico" />
        <ui:VisualElement name="diagnostico" class="oculto" style="position: absolute; left: 0; top: 52px; right: 0; bottom: 0; background-color: rgba(11, 8, 5, 0.88);" />
    </ui:VisualElement>
</ui:UXML>
