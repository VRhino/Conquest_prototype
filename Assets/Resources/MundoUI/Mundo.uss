/* «Bronce y arcilla» (BronzeAgeClient: docs/Diseno_Interfaz.md y src/style.css) en USS, para las pantallas de fuera de la batalla.
   USS no tiene degradados ni sombras: la placa de bronce se hace con bordes (banda de bronce oscuro y filete de bronce). Usa los tokens, no
   metas colores sueltos. Los titulares van en versales escritas como tales (USS no tiene text-transform). Letras del prototipo (SIL OFL,
   en Fuentes/): Inter para el texto y Cinzel para titulares, nombres y la acción principal. */
:root {
    --tinta: #0b0805;
    --marco-bg: #191410;
    --marco-bg-alt: #221a12;
    --marco-panel: #14100c;
    --bronce: #a9793f;
    --bronce-osc: #6b4a29;
    --oro: #d8b878;
    --oro-claro: #f1dcae;
    --terracota: #bf5233;
    --pergamino: #ede0c4;
    --texto-2: #b8ab92;
    --texto-apagado: #8a7d66;
    --verde: #8fc79f;
    --rojo-claro: #f0a58f;
    color: var(--pergamino);
    font-size: 16px;
    -unity-font: url("Fuentes/Inter-Regular.ttf");
    -unity-font-definition: initial;
}

.fondo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--tinta); align-items: center; justify-content: center; }

/* La placa de bronce: banda oscura, filete de bronce y fondo cálido. */
.placa {
    background-color: var(--marco-bg-alt);
    border-width: 4px; border-color: var(--bronce-osc); border-radius: 3px;
}
.placa-filete { border-width: 1px; border-color: var(--bronce); border-radius: 1px; padding: 28px 30px; background-color: var(--marco-bg); }

.tarjeta { width: 460px; }
.tarjeta-ancha { width: 620px; }

.titulo { font-size: 28px; -unity-font-style: bold; color: var(--oro-claro); letter-spacing: 6px; -unity-text-align: middle-center; }
.subtitulo { font-size: 14px; color: var(--texto-2); -unity-text-align: middle-center; margin-top: 4px; margin-bottom: 18px; }
.kicker { font-size: 12px; -unity-font-style: bold; color: var(--oro); letter-spacing: 5px; margin-top: 14px; margin-bottom: 6px; }
.denticulo { height: 3px; margin-bottom: 14px; border-top-width: 1px; border-bottom-width: 1px; border-color: var(--bronce-osc); opacity: 0.7; }

/* Botones: el primario es la placa de oro (uno por pantalla); el secundario, bronce oscuro. */
Button { margin: 0; }
.boton-primario {
    background-color: var(--oro); color: #201509; -unity-font-style: bold; letter-spacing: 3px; font-size: 15px;
    border-width: 1px; border-color: var(--oro-claro); border-bottom-color: #8f6a35; border-radius: 3px;
    height: 44px; margin-top: 12px;
    transition-property: translate, background-color; transition-duration: 0.12s;
}
.boton-primario:hover { background-color: var(--oro-claro); translate: 0 -1px; }
.boton-primario:active { translate: 0 1px; }
.boton-primario:disabled { opacity: 0.55; }
.boton-secundario {
    background-color: #1d1610; color: var(--pergamino); border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px;
    padding: 6px 14px; font-size: 14px;
}
.boton-secundario:hover { border-color: var(--bronce); color: var(--oro-claro); }
.boton-peligro { background-color: var(--terracota); border-color: var(--terracota); color: var(--pergamino); }
.enlace { background-color: rgba(0, 0, 0, 0); border-width: 0; color: var(--oro); font-size: 13px; padding: 4px 0; -unity-text-align: middle-left; }
.enlace:hover { color: var(--oro-claro); }

/* Pestañas Entrar / Crear cuenta */
.pestanas { flex-direction: row; padding: 3px; margin-bottom: 18px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: var(--marco-panel); }
.pestana { flex-grow: 1; flex-basis: 0; height: 34px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: var(--texto-2); font-size: 14px; -unity-font-style: bold; }
.pestana:hover { color: var(--pergamino); }
.pestana--activa { background-color: #3a2c1a; color: var(--oro); border-width: 1px; border-color: var(--bronce); }

/* Formularios */
.campo { margin-bottom: 12px; }
.etiqueta { font-size: 13px; color: var(--texto-2); margin-bottom: 4px; }
.entrada { margin: 0; }
.entrada > .unity-text-field__input, .entrada > .unity-base-text-field__input {
    background-color: var(--tinta); border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px;
    color: var(--pergamino); font-size: 15px; padding: 8px 10px; height: 38px;
}
.entrada:focus > .unity-text-field__input, .entrada:focus > .unity-base-text-field__input { border-color: var(--oro); }
.campo--error .unity-base-text-field__input { border-color: var(--terracota); }
.campo-error { font-size: 12px; color: var(--rojo-claro); margin-top: 3px; white-space: normal; }
.campo-ayuda { font-size: 12px; color: var(--texto-apagado); margin-top: 3px; white-space: normal; }
.oculto { display: none; }

.error { background-color: rgba(191, 82, 51, 0.18); border-width: 1px; border-color: var(--terracota); border-radius: 3px; color: var(--rojo-claro); padding: 8px 12px; margin-bottom: 12px; white-space: normal; font-size: 14px; }
.aviso-ok { background-color: rgba(110, 200, 140, 0.12); border-width: 1px; border-color: rgba(110, 200, 140, 0.4); border-radius: 3px; color: var(--verde); padding: 8px 12px; margin-bottom: 12px; white-space: normal; font-size: 14px; }
.pie { font-size: 11px; color: var(--texto-apagado); -unity-text-align: middle-center; margin-top: 16px; }

/* Partidas */
.partida { flex-direction: column; align-items: stretch; padding: 10px 12px; margin-bottom: 8px; background-color: rgba(34, 26, 18, 0.6); border-width: 1px; border-color: var(--bronce-osc); border-left-width: 3px; border-radius: 2px; }
.partida:hover { border-color: var(--bronce); }
.partida--elegida { border-color: var(--oro); background-color: rgba(216, 184, 120, 0.12); }
.partida-nombre { font-size: 17px; -unity-font-style: bold; color: var(--oro-claro); -unity-text-align: middle-left; }
.partida-heroe { font-size: 14px; color: var(--pergamino); -unity-text-align: middle-left; margin-top: 4px; }
.partida-detalle { font-size: 12px; color: var(--texto-2); -unity-text-align: middle-left; }
.vacio { color: var(--texto-apagado); font-size: 14px; -unity-text-align: middle-center; padding: 16px; }

/* Pantalla de carga */
.carga { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--tinta); transition-property: opacity; transition-duration: 0.45s; }
.carga--saliendo { opacity: 0; }
.carga-imagen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; opacity: 0; transition-property: opacity, scale; transition-duration: 0.6s, 16s; }
.carga-imagen--cargada { opacity: 1; scale: 1.06 1.06; }
.carga-consejo { position: absolute; left: 0; right: 0; bottom: 0; height: 25%; min-height: 170px; padding: 0 14% 62px 14%; align-items: center; justify-content: center; background-color: rgba(14, 10, 6, 0.78); }
.carga-kicker { font-size: 12px; -unity-font-style: bold; letter-spacing: 6px; color: var(--oro); margin-bottom: 8px; }
.carga-texto { font-size: 19px; color: var(--pergamino); -unity-text-align: middle-center; white-space: normal; max-width: 760px; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); }
.carga-pie { position: absolute; left: 25%; right: 25%; bottom: 20px; align-items: center; }
.carga-titulo { font-size: 13px; letter-spacing: 3px; color: var(--oro-claro); margin-bottom: 7px; }
.carga-barra { width: 100%; height: 8px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 4px; background-color: rgba(0, 0, 0, 0.6); overflow: hidden; }
.carga-barra-relleno { height: 100%; width: 0; background-color: var(--oro); transition-property: width; transition-duration: 0.25s; }

/* Pantalla de la sesión viva (provisional hasta el mapa) */
.barra-arriba { position: absolute; left: 0; top: 0; right: 0; height: 52px; flex-direction: row; align-items: center; padding: 0 14px; background-color: var(--marco-panel); border-bottom-width: 2px; border-color: var(--bronce-osc); }
.barra-arriba .titulo { font-size: 17px; letter-spacing: 4px; -unity-text-align: middle-left; flex-grow: 1; }
.barra-arriba Button { margin-left: 8px; }
.diagnostico { position: absolute; left: 24px; top: 72px; right: 24px; bottom: 24px; flex-direction: row; }
.columna { flex-grow: 1; flex-basis: 0; margin-left: 8px; margin-right: 8px; }
.ficha { flex-direction: row; justify-content: space-between; padding: 6px 10px; margin-bottom: 4px; background-color: var(--marco-bg-alt); border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; }
.ficha-etiqueta { color: var(--texto-apagado); font-size: 13px; }
.ficha-valor { color: var(--oro-claro); font-size: 13px; -unity-text-align: middle-right; white-space: normal; flex-shrink: 1; }
.reloj { font-size: 30px; color: var(--oro-claro); -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 6px; }
.insignia { background-color: var(--terracota); color: var(--pergamino); border-radius: 9px; padding: 0 6px; font-size: 12px; margin-left: 6px; -unity-font-style: bold; }

/* Avisos: el aviso flotante arriba al centro, y el panel con su historial */
.toast { position: absolute; top: 64px; left: 30%; right: 30%; padding: 10px 18px; background-color: var(--marco-bg-alt); border-width: 2px; border-color: var(--bronce); border-radius: 3px; color: var(--pergamino); -unity-text-align: middle-center; white-space: normal; font-size: 15px; transition-property: opacity; transition-duration: 0.3s; }
.toast--peligro { border-color: var(--terracota); color: var(--rojo-claro); }
.toast--oculto { opacity: 0; }
.panel-avisos { position: absolute; top: 60px; right: 12px; bottom: 12px; width: 420px; }
.panel-avisos .placa-filete { flex-grow: 1; padding: 14px 16px; }
.avisos-cab { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; margin-bottom: 4px; }
.avisos-seccion-titulo { font-size: 14px; -unity-font-style: bold; color: var(--oro); background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; -unity-text-align: middle-left; }
.avisos-urgentes .avisos-seccion-titulo { color: var(--terracota); }
.aviso { flex-direction: row; padding: 7px 10px; margin-bottom: 4px; background-color: rgba(34, 26, 18, 0.7); border-width: 1px; border-color: var(--bronce-osc); border-left-width: 3px; border-radius: 2px; }
.aviso--nuevo { border-left-color: var(--oro); }
.aviso--urgente { border-left-color: var(--terracota); }
.aviso-cuerpo { flex-grow: 1; flex-shrink: 1; }
.aviso-titulo { font-size: 13px; -unity-font-style: bold; color: var(--oro-claro); }
.aviso-texto { font-size: 13px; color: var(--pergamino); white-space: normal; }
.aviso-cuando { font-size: 11px; color: var(--texto-apagado); }
.aviso-borrar { background-color: rgba(0, 0, 0, 0); border-width: 0; color: var(--texto-apagado); font-size: 16px; width: 22px; padding: 0; }
.aviso-borrar:hover { color: var(--rojo-claro); }

/* El cuadro de confirmación del juego */
.dialogo-velo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10, 8, 5, 0.65); align-items: center; justify-content: center; }
.dialogo { width: 460px; }
.dialogo .placa-filete { padding: 18px 20px 16px 20px; }
.dialogo-titulo { font-size: 17px; -unity-font-style: bold; color: var(--oro-claro); letter-spacing: 1px; margin-bottom: 8px; }
.dialogo-texto { font-size: 15px; color: var(--pergamino); white-space: normal; margin-bottom: 16px; }
.dialogo-botones { flex-direction: row; justify-content: flex-end; }
.dialogo-botones Button { margin-left: 8px; }
.dialogo-botones .boton-primario { margin-top: 0; height: 36px; padding: 0 18px; }

/* Las letras: Cinzel para lo que en la guía va con --fuente-titulo; Inter seminegrita para el resto de lo destacado. */
.titulo, .kicker, .boton-primario, .carga-kicker, .carga-titulo, .dialogo-titulo, .partida-nombre, .reloj {
    -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; -unity-font-style: normal;
}
.pestana, .aviso-titulo, .insignia, .avisos-seccion-titulo { -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; -unity-font-style: normal; }

/* El mapa de mundo: nombres sobre el mapa, la ficha de lo seleccionado, la lista bajo el clic y el aviso de dentro (BronzeAgeClient:
   `mundo3d.css`, `.mapa-seleccion`, `.eleccion-clic`). */
.nombre-mapa { position: absolute; translate: -50% -100%; flex-direction: row; align-items: center; padding: 2px 7px; background-color: rgba(10, 14, 23, 0.78); border-left-width: 3px; border-radius: 2px; }
.nombre-mapa > Label { font-size: 12px; color: rgb(255, 255, 255); padding: 0; margin: 0; }
.nombre-mapa--nodo > Label { font-size: 11px; color: rgb(220, 214, 200); }
.nombre-mapa--tenue { opacity: 0.6; }
.panel-mapa-arriba { position: absolute; top: 120px; left: 30%; right: 30%; }
.fila-mapa { flex-direction: row; align-items: center; }
.ficha-mapa { position: absolute; right: 12px; bottom: 12px; width: 340px; }
.lista-fila { flex-direction: column; align-items: stretch; padding: 7px 10px; margin-bottom: 4px; background-color: rgba(34, 26, 18, 0.7); border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; }
.lista-fila:hover { border-color: var(--bronce); }
.ficha-mapa .boton-secundario { margin-bottom: 6px; height: 32px; }

/* Crear el héroe: la lista de campamentos a la izquierda y la ficha con el nombre a la derecha, sobre el mapa. */
.panel-izquierda { position: absolute; left: 12px; top: 64px; bottom: 12px; width: 300px; }
.panel-derecha { position: absolute; right: 12px; top: 64px; bottom: 12px; width: 420px; }
.panel-relleno { flex-grow: 1; padding: 14px 16px; }
.fila-envuelta { flex-direction: row; flex-wrap: wrap; }
.fila-envuelta > Button { margin: 0 6px 6px 0; }
.campamento { flex-direction: column; align-items: stretch; padding: 8px 10px; margin-bottom: 6px; background-color: rgba(34, 26, 18, 0.7); border-width: 1px; border-color: var(--bronce-osc); border-left-width: 3px; border-radius: 2px; }
.campamento:hover { border-color: var(--bronce); }
.campamento--elegido, .clase--elegida { border-color: var(--oro); background-color: rgba(216, 184, 120, 0.16); }
.clase--elegida { color: var(--oro-claro); }
.campamento--comparado { border-left-color: var(--oro-claro); }
/* La tarjeta es un botón sin aspecto de botón (para elegir) y debajo la casilla de comparar. */
.campamento-boton { flex-direction: column; align-items: stretch; margin: 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-text-align: middle-left; }
.campamento-recomendado { color: var(--oro); font-size: 12px; margin-left: 6px; -unity-text-align: middle-left; }
.campamento-comparar { margin: 4px 0 0 0; font-size: 12px; color: var(--texto-2); }
/* Comparar dos campamentos: una fila por dato, el mejor en oro. */
.comparar-fila { flex-direction: row; align-items: center; justify-content: space-between; padding: 3px 0; border-bottom-width: 1px; border-color: rgba(107, 74, 41, 0.5); }
.comparar-titulo { width: 30%; color: var(--texto-2); font-size: 12px; white-space: normal; }
.comparar-valor { width: 35%; white-space: normal; font-size: 13px; }
.comparar-gana { color: #9fe0a0; background-color: rgba(39, 174, 96, 0.12); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; -unity-font-style: normal; }
.puntos { color: var(--oro); letter-spacing: 2px; }

/* El interior de un campamento (paso 4): la cabecera y la ayuda de abajo; la ventana «Salir al mundo». */
.ayuda-interior { position: absolute; left: 14px; bottom: 10px; font-size: 12px; color: var(--pergamino); background-color: rgba(20, 15, 10, 0.6); padding: 4px 8px; border-radius: 2px; }
.salida { width: 520px; max-height: 90%; }
.salida-fila { flex-direction: row; align-items: center; justify-content: space-between; padding: 3px 0; }
.salida-fila IntegerField { width: 110px; margin: 0; }
.salida-seccion { margin-bottom: 10px; }
.cartel-interior { position: absolute; left: 35%; right: 35%; bottom: 18%; -unity-text-align: middle-center; font-size: 18px; color: var(--oro-claro); background-color: rgba(20, 15, 10, 0.8); border-width: 1px; border-color: var(--bronce-osc); padding: 8px 14px; border-radius: 2px; }
.panel-campamento { width: 640px; max-height: 88%; }
.panel-campamento .salida-fila Button { margin-left: 8px; }
/* Los campos de número de las ventanas (cantidad, carga): legibles sobre la placa. */
.dialogo .unity-base-text-field__input { color: var(--pergamino); background-color: rgba(10, 8, 5, 0.7); border-color: var(--bronce-osc); -unity-font: url("Fuentes/Inter-Regular.ttf"); -unity-font-definition: initial; }

/* Los iconos del prototipo (`IconosDelMundo`; BronzeAgeClient: style.css). */
.con-icono { flex-direction: row; align-items: center; }
.con-icono > .icono { margin-right: 6px; }
/* La pieza de un recurso (`.asent-recurso`): su emoji y la cifra. */
.chip-recurso {
    flex-direction: row; align-items: center; padding: 2px 6px; margin: 0 4px 4px 0;
    border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; background-color: rgba(0, 0, 0, 0.28);
}
.chip-recurso > .icono { margin-right: 4px; }
.chip-recurso-cifra { color: var(--oro-claro); font-size: 13px; }
.chip-recurso--falta .chip-recurso-cifra { color: #e2675a; }
/* Un chip de dato (`.obra-chip`): píldora oscura. */
.chip { flex-direction: row; align-items: center; padding: 2px 9px; margin: 0 6px 4px 0; border-width: 1px; border-color: var(--bronce-osc); border-radius: 9px; background-color: rgba(0, 0, 0, 0.35); }
.chip > .icono { margin-right: 4px; }
/* El título de una ventana con su icono (`htmlTituloDeParte`). */
.titulo-con-icono { flex-direction: row; align-items: center; }
.titulo-con-icono > .icono { margin-right: 10px; }
/* La cabecera de un carril (`.ta-carril`): el icono del edificio y su nombre en oro. */
.carril { flex-direction: row; align-items: center; margin-top: 14px; margin-bottom: 6px; }
.carril > .icono { margin-right: 8px; }
/* El mercado del campamento (`.mercado-bien`, `.mercado-total`). */
.mercado-bien { flex-direction: row; align-items: center; min-width: 150px; padding: 5px 9px; margin: 0 6px 6px 0; background-color: #1d1610; border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; }
.mercado-bien:hover { border-color: var(--bronce); }
.mercado-bien.clase--elegida { border-color: var(--oro); background-color: rgb(58, 44, 26); }
.mercado-bien > .icono { margin-right: 8px; }
.mercado-bien-nombre { color: var(--pergamino); font-size: 14px; -unity-text-align: middle-left; }
.mercado-bien-detalle { color: var(--texto-apagado); font-size: 11px; -unity-text-align: middle-left; }
.mercado-total { flex-direction: row; margin-top: 8px; }
.mercado-total-caja { flex-grow: 1; flex-basis: 0; padding: 5px 8px; margin-right: 6px; border-width: 1px; border-color: var(--bronce-osc); background-color: rgba(0, 0, 0, 0.25); }
.mercado-total-titulo { font-size: 11px; color: var(--texto-apagado); }
.mercado-total-valor { font-size: 17px; color: var(--oro-claro); }
.mercado-hecho { color: #9ad07a; }
/* La cifra de la carga del carro, en rojo si no cabe (`[data-carga-total].excedido`). */
.excedido { color: #e8806f; }
/* La placa «Tu almacén» del interior (`.asent-pie-grupo`). */
.placa-almacen { position: absolute; left: 12px; bottom: 34px; max-width: 60%; padding: 6px 8px 2px 8px; background-color: var(--marco-bg-alt); border-width: 1px; border-color: var(--bronce); border-top-color: var(--oro); border-radius: 3px; }
.placa-almacen-titulo { font-size: 10px; color: var(--oro); letter-spacing: 3px; margin-bottom: 4px; }
.cabecera-icono { margin-right: 12px; }
/* Las filas de nodos del mapa con su icono. */
.nombre-mapa-icono { width: 16px; height: 16px; margin-right: 5px; flex-shrink: 0; }
.lista-fila-cab { flex-direction: row; align-items: center; }
.lista-fila-icono { width: 26px; height: 26px; border-radius: 13px; margin-right: 8px; align-items: center; justify-content: center; background-color: var(--tinta); border-width: 1px; border-color: var(--bronce-osc); }
.lista-fila-texto { flex-shrink: 1; flex-grow: 1; }
/* «Nace tu héroe»: el edificio militar, las tropas del primer día y los yacimientos (`.elegir-*`). */
.elegir-edificio { width: 44px; height: 44px; align-items: center; justify-content: center; border-width: 1px; border-color: #4a3722; border-radius: 6px; margin-right: 8px; }
.elegir-tropa { flex-direction: row; align-items: center; padding: 2px 9px 2px 3px; margin: 0 6px 6px 0; border-radius: 14px; background-color: #241b12; border-width: 1px; border-color: var(--bronce-osc); }
.elegir-tropa > .icono { margin-right: 5px; }
.elegir-tropa > Label { font-size: 12px; color: var(--pergamino); }
.elegir-tropa--despues { opacity: 0.45; }
.chip-texto { color: var(--oro-claro); font-size: 12px; }
.carril-texto { color: var(--oro); font-size: 12px; -unity-font-style: bold; letter-spacing: 5px; }
.boton-texto { color: #201509; -unity-font-style: bold; letter-spacing: 2px; font-size: 14px; }
.boton-primario .chip-recurso { background-color: rgba(20, 14, 8, 0.78); }
.bandidos-nivel { flex-direction: row; align-items: center; margin-bottom: 8px; }
.bandidos-nivel-punto { width: 14px; height: 14px; margin-right: 5px; border-width: 1px; border-color: var(--terracota); border-radius: 7px; }
.bandidos-nivel-punto--on { background-color: var(--terracota); }
.bandidos-nivel .campo-ayuda { margin: 0 0 0 6px; }
.ficha .con-icono { flex-shrink: 0; margin-right: 10px; }
.ficha .con-icono > .icono { margin-right: 6px; }
.comparar-nodo { font-size: 13px; margin-right: 8px; }
.comparar-gana .comparar-nodo { color: #9fe0a0; } /* `td.gana` del prototipo */
/* Un botón con su glifo (`.puerta-boton-icono`). */
.boton-con-glifo { flex-direction: row; align-items: center; justify-content: center; }
.boton-con-glifo > .icono { margin-right: 8px; }
.boton-con-glifo-texto { padding: 0; margin: 0; color: var(--pergamino); font-size: 14px; }
.boton-con-glifo:hover > .boton-con-glifo-texto { color: var(--oro-claro); }
/* El error de acceso y partidas con su ⚠️ (`.error-banner`). */
.error-fila { flex-direction: row; align-items: flex-start; background-color: rgba(191, 82, 51, 0.18); border-width: 1px; border-color: var(--terracota); border-radius: 3px; padding: 8px 12px; margin-bottom: 12px; }
.error-texto { color: var(--rojo-claro); white-space: normal; font-size: 14px; flex-shrink: 1; padding: 0; margin: 0; }
.icono-aviso { width: 16px; height: 16px; margin: 1px 8px 0 0; flex-shrink: 0; background-image: resource("MundoUI/Iconos/glifo/aviso"); }
/* Las piezas de tropa de Conquest (`PiezasDeTropa`; gemelas de Squad_Icon, Squad_option y las estrellas de SquadDetailPanel). */
.tropa-mini { flex-shrink: 0; margin-right: 8px; }
.tropa-mini-fondo, .tropa-mini-icono { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.tropa-mini-linea { position: absolute; left: 0; right: 0; bottom: 0; }
.tropa-tarjeta { flex-shrink: 0; margin: 0 8px 8px 0; }
.tropa-tarjeta-capa { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.tropa-tarjeta-franja { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 6px 3px 6px; background-color: rgba(56, 56, 56, 0.6); }
.tropa-tarjeta-linea { position: absolute; left: 0; right: 0; bottom: 0; }
.tropa-tarjeta-marca { position: absolute; left: -1px; top: -1px; right: -1px; bottom: -1px; background-color: rgba(255, 255, 255, 0.11); display: none; }
.tropa-tarjeta--elegida > .tropa-tarjeta-marca { display: flex; }
.tropa-tarjeta-liderazgo-icono { margin-left: 2px; background-image: url("/Assets/Art/UI/units/leadership.png"); -unity-background-scale-mode: scale-to-fit; }
.tropa-tarjeta-datos { flex-direction: row; align-items: center; }
.tropa-tarjeta-liderazgo { flex-direction: row; align-items: center; margin-left: 6px; }
.tropa-tarjeta-nivel, .tropa-tarjeta-cifra, .tropa-tarjeta-hombres { color: rgb(255, 255, 255); font-size: 16px; -unity-font-style: bold; padding: 0; margin: 0; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.tropa-estrellas { flex-direction: row; }
.tropa-estrella { padding: 0; margin: 0; -unity-text-align: middle-left; }
/* Una tropa con lo que se hace con ella debajo (las del campamento y la salida). */
.tropa-con-accion { width: 150px; margin: 0 10px 12px 0; }
.tropa-con-accion > .tropa-tarjeta { margin: 0 0 6px 0; }
.tropa-con-accion > Label { white-space: normal; }
.tropa-con-accion > Button { margin: 4px 0 0 0; }
/* La casilla «Sale» bajo la tarjeta: sin el ancho mínimo de la etiqueta de los campos (empujaba la casilla fuera de la columna). */
.tropa-con-accion > Toggle { margin: 2px 0 0 0; }
.tropa-con-accion .unity-base-field__label { min-width: 0; margin-right: 8px; }

/* «Salir al mundo», calcada de la del prototipo (style.css: .salida-ventana, .salida-cuerpo, .salida-col, .salida-pie, .salida-velocidad,
   .salida-tropa-cab, .salida-huecos, .salida-hueco…). */
.salida-ventana { width: 980px; max-width: 96%; height: 680px; max-height: 94%; flex-direction: column; padding: 0; background-color: var(--marco-bg); border-width: 1px; border-color: var(--bronce); border-radius: 3px; }
.salida-cab { flex-direction: row; align-items: center; justify-content: space-between; padding: 10px 16px; border-bottom-width: 1px; border-color: var(--bronce-osc); flex-shrink: 0; }
.salida-titulo { margin: 0; font-size: 18px; letter-spacing: 2px; }
.salida-cerrar { width: 30px; height: 30px; padding: 0; font-size: 18px; -unity-text-align: middle-center; }
.salida-cuerpo { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; }
.salida-col { flex-grow: 1; flex-basis: 0; padding: 16px 20px; background-color: var(--marco-bg-alt); }
.salida-col--derecha { border-left-width: 1px; border-color: var(--bronce-osc); background-color: var(--marco-panel); }
.salida-recuadro { margin-top: 10px; padding: 8px 10px; border-width: 1px; border-color: #4a4538; border-radius: 6px; }
.salida-recuadro-titulo { font-size: 14px; color: var(--oro-claro); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; margin: 0; }
.salida-carga-total { font-size: 14px; color: var(--oro-claro); margin: 0 0 0 6px; }
.salida-carga-total.excedido { color: #e8806f; }
.con-ayuda { flex-direction: row; align-items: center; }
.ayuda-boton { width: 20px; height: 20px; padding: 0; margin: 0 0 0 6px; border-width: 1px; border-color: var(--bronce); border-radius: 10px; background-color: rgba(0, 0, 0, 0); color: var(--pergamino); font-size: 12px; -unity-text-align: middle-center; opacity: 0.75; }
.ayuda-boton:hover { opacity: 1; background-color: rgba(212, 168, 75, 0.15); }
.ayuda-texto { margin: 6px 0 4px 0; padding: 6px 10px; border-left-width: 2px; border-color: var(--bronce); font-size: 12px; color: var(--texto-2); white-space: normal; }
.carro-fila { margin-top: 6px; }
.carro-fila IntegerField { width: 84px; margin: 0 6px 0 6px; }
.carro-fila Button { padding: 4px 10px; }
.carro-hay { margin: 0 0 0 6px; }
.salida-pie { flex-shrink: 0; padding: 10px 16px 12px 16px; border-top-width: 1px; border-color: var(--bronce-osc); background-color: rgba(169, 121, 63, 0.08); }
.salida-velocidad { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 5px 10px; border-width: 1px; border-left-width: 4px; border-radius: 3px; background-color: rgba(20, 16, 11, 0.55); margin-bottom: 8px; }
.salida-velocidad.ritmo-lenta { border-color: #e2675a; color: #e2675a; }
.salida-velocidad.ritmo-ligera { border-color: #f4efe4; color: #f4efe4; }
.salida-velocidad.ritmo-rapida { border-color: #6fb6ff; color: #6fb6ff; }
.salida-velocidad-etq { font-size: 12px; color: var(--oro); letter-spacing: 2px; margin: 0 6px 0 0; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.salida-velocidad-flechas { flex-direction: row; margin: 0 6px 0 4px; }
.salida-velocidad-flecha { font-size: 22px; -unity-font-style: bold; margin: -4px 0 0 0; padding: 0; }
.salida-velocidad-cifra { font-size: 17px; -unity-font-style: bold; margin: 0 4px 0 0; padding: 0; }
.salida-velocidad-unidad { font-size: 11px; opacity: 0.85; margin: 0 8px 0 0; padding: 0; }
.salida-velocidad-texto { font-size: 12px; color: var(--texto-2); padding: 0; margin: 0; }
.salida-tropa-cab { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 8px; }
.salida-liderazgo { font-size: 13px; color: var(--texto-2); margin: 0 0 0 14px; }
.salida-liderazgo.excedido { color: #d9534f; }
.salida-loadout { margin: 0 8px 0 auto; }
.salida-loadout > Label { min-width: 0; margin-right: 6px; font-size: 13px; color: var(--texto-2); }
.salida-guardar { padding: 3px 10px; font-size: 12px; }
.salida-riel { flex-shrink: 0; height: 190px; }
.salida-riel .unity-scroll-view__content-container { flex-direction: row; }
.salida-hueco { width: 110px; height: 174px; margin-right: 8px; flex-shrink: 0; border-radius: 3px; }
.salida-hueco-tropa { }
.salida-hueco-quitar { position: absolute; top: 2px; right: 2px; width: 20px; height: 20px; padding: 0; background-color: rgba(10, 8, 5, 0.65); border-width: 0; border-radius: 10px; color: var(--texto-2); font-size: 11px; -unity-text-align: middle-center; }
.salida-hueco-quitar:hover { color: #d9534f; }
.salida-hueco-vacio { background-image: resource("MundoUI/Iconos/simbolo/hueco"); -unity-background-image-tint-color: rgba(169, 121, 63, 0.35); background-color: rgba(20, 16, 11, 0.35); }
.salida-hueco-mas { background-image: resource("MundoUI/Iconos/simbolo/hueco"); -unity-background-image-tint-color: rgba(169, 121, 63, 0.8); background-color: rgba(20, 16, 11, 0.45); border-width: 0; color: var(--oro); font-size: 30px; -unity-text-align: middle-center; padding: 0; }
.salida-hueco-mas:hover, .salida-hueco-mas.activo { -unity-background-image-tint-color: var(--oro); color: var(--oro-claro); background-color: rgba(169, 121, 63, 0.16); }
.salida-elegir { padding: 8px; margin-top: 6px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.25); }
.salida-candidata { flex-direction: row; align-items: center; padding: 4px 10px 4px 6px; margin: 0 6px 6px 0; border-width: 1px; border-color: var(--bronce); border-radius: 3px; background-color: rgb(40, 30, 18); }
.salida-candidata:hover { border-color: var(--oro); }
.salida-acciones { flex-direction: row; align-items: center; justify-content: flex-end; margin-top: 8px; }
.salida-acciones > .error { flex-grow: 1; flex-shrink: 1; margin: 0 12px 0 0; }
.salida-salir { width: 130px; margin-top: 0; }
/* Los campos de la ventana de salida, oscuros como los de los demás diálogos (el desplegable del loadout también). */
.salida-ventana .unity-base-text-field__input, .salida-loadout .unity-base-popup-field__input { color: var(--pergamino); background-color: rgba(10, 8, 5, 0.7); border-color: var(--bronce-osc); -unity-font: url("Fuentes/Inter-Regular.ttf"); -unity-font-definition: initial; font-size: 13px; }
.salida-loadout { flex-direction: row; align-items: center; }
.salida-loadout > Label { -unity-text-align: middle-left; padding-top: 0; }
.salida-loadout .unity-base-popup-field__input { min-width: 150px; padding: 3px 6px; }
.salida-loadout .unity-base-popup-field__text { -unity-text-align: middle-left; padding: 0; margin: 0; }

/* La preparación de la batalla (PantallasDeMundo.Preparacion): la BattlePrepScene de Conquest calcada, con sus colores, su letra
   (LiberationSans, la de sus TMP) y sus sprites (Assets/Art/UI). Las medidas, en el código (las de la original a 1950x1130). */
.prep-fondo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #383838; overflow: hidden; }
.prep-lienzo { position: absolute; width: 1950px; height: 1130px; transform-origin: left top;
    -unity-font: url("/Assets/TextMesh Pro/Fonts/LiberationSans.ttf"); -unity-font-definition: initial; color: #ffffff; }
.prep-lienzo Label { margin: 0; padding: 0; }
.prep-mapa-nombre { font-size: 25px; -unity-text-align: middle-left; height: 100%; }
.prep-raya { background-color: #ffffff; }
.prep-temporizador { font-size: 40px; color: #ff0000; -unity-font-style: bold; -unity-text-align: middle-center; height: 100%; }
.prep-estado-caja { align-items: flex-end; justify-content: center; }
.prep-estado { font-size: 20px; -unity-text-align: middle-right; }
.prep-plazo { font-size: 15px; color: #cfcfcf; -unity-text-align: middle-right; }
.prep-heroe { background-image: url("/Assets/Art/UI/gradient.png"); -unity-background-scale-mode: stretch-to-fill; }
.prep-circulo { background-image: url("/Assets/Art/UI/plain-circle.png"); -unity-background-scale-mode: stretch-to-fill; }
.prep-circulo--negro { -unity-background-image-tint-color: #000000; }
.prep-circulo--clase { -unity-background-image-tint-color: #597093; }
.prep-circulo--nivel { -unity-background-image-tint-color: #a77044; align-items: center; justify-content: center; }
.prep-anillo { background-image: url("/Assets/Art/UI/circle.png"); -unity-background-image-tint-color: #5983cb; -unity-background-scale-mode: stretch-to-fill; }
.prep-heroe-nombre { font-size: 18px; -unity-text-align: middle-left; height: 100%; overflow: hidden; }
.prep-heroe-nivel { font-size: 18px; -unity-text-align: middle-center; }
.prep-heroe-estado { font-size: 15px; color: #cfcfcf; -unity-text-align: middle-right; height: 100%; }
.prep-heroe-estado--listo { color: #8fc79f; -unity-font-style: bold; }
.prep-liderazgo-icono { background-image: url("/Assets/Art/UI/units/leadership.png"); -unity-background-scale-mode: scale-to-fit; }
.prep-liderazgo { font-size: 36px; -unity-font-style: bold; -unity-text-align: middle-center; height: 100%; }
.prep-boton-negro { margin: 0; padding: 0; background-color: #1f1f1f; border-width: 0; border-radius: 3px; color: #ffffff; font-size: 19px; -unity-text-align: middle-center; }
.prep-boton-negro:hover { background-color: #333333; }
.prep-error { font-size: 16px; color: #ff8a7a; -unity-text-align: middle-center; height: 100%; background-color: rgba(0, 0, 0, 0.6); }
.prep-aviso { font-size: 20px; -unity-text-align: middle-center; height: 100%; }
.prep-escuadra { }
.prep-hueco { background-color: #292929; }
.prep-hueco-mas { background-image: url("/Assets/Art/UI/plus-square.png"); -unity-background-scale-mode: stretch-to-fill; opacity: 0.3; }
.prep-franja { position: absolute; left: 0; top: 0; right: 0; height: 26px; flex-direction: row; align-items: center; background-color: rgba(20, 20, 20, 0.72); }
.prep-flecha { width: 24px; height: 24px; margin: 1px; padding: 0; border-width: 0; border-radius: 2px; background-color: rgba(255, 255, 255, 0.12); color: #ffffff; font-size: 12px; -unity-text-align: middle-center; }
.prep-flecha:hover { background-color: rgba(255, 255, 255, 0.28); }
.prep-flecha:disabled { opacity: 0.3; }
.prep-formacion { flex-grow: 1; flex-shrink: 1; margin: 0 2px; }
.prep-formacion .unity-base-popup-field__input { color: #ffffff; background-color: rgba(0, 0, 0, 0.55); border-width: 0; font-size: 12px; padding: 1px 4px; min-width: 0; height: 22px; }
.prep-formacion .unity-base-popup-field__text { -unity-text-align: middle-left; padding: 0; margin: 0; }
.prep-casilla { background-color: #1f1f1f; justify-content: center; align-items: center; }
.prep-casilla--llena { background-image: url("/Assets/Art/UI/common_background_square.png"); -unity-background-scale-mode: stretch-to-fill; }
.prep-casilla-texto { font-size: 12px; white-space: normal; -unity-text-align: middle-center; padding: 4px; color: #e6e6e6; }
.prep-equipo-aviso-caja { justify-content: center; padding: 0 8px; background-color: rgba(0, 0, 0, 0.55); border-radius: 3px; }
.prep-equipo-aviso { font-size: 14px; white-space: normal; color: #ffffff; }
.prep-ahora-caja { justify-content: center; padding: 0 10px; background-color: rgba(0, 0, 0, 0.55); border-radius: 3px; }
.prep-ahora { font-size: 15px; white-space: normal; color: #ffffff; }
.prep-start { margin: 0; padding: 0; background-color: #e3cc7f; border-width: 0; border-radius: 4px; color: #000000; font-size: 30px; -unity-text-align: middle-center; }
.prep-start:hover { background-color: #efdb98; }
.prep-start:disabled { opacity: 0.55; }

/* El informe de combate (PantallasDeMundo.Informe), calcado de `.briefing` del prototipo (style.css 2877-2932). */
.informe-velo { background-color: var(--tinta); align-items: stretch; justify-content: flex-start; }
.informe { flex-grow: 1; margin: 20px; padding: 26px 34px; background-color: var(--marco-bg-alt); border-width: 1px; border-color: var(--bronce); border-radius: 3px; }
.informe-cuerpo { flex-grow: 1; flex-shrink: 1; }
.informe-columnas { flex-direction: row; align-items: flex-start; margin: 0 -12px; flex-shrink: 0; }
.informe-columna { flex-grow: 1; flex-basis: 0; margin: 0 12px; }
.informe-columna > * { margin-bottom: 10px; flex-shrink: 0; }
.informe-columna > .informe-bando { flex-grow: 0; flex-basis: auto; margin: 0 0 10px 0; }
.informe-recuadros { flex-direction: row; flex-wrap: wrap; margin: 4px -6px 0 -6px; flex-shrink: 0; }
.informe-recuadros > .informe-recuadro { flex-grow: 1; flex-basis: 260px; margin: 0 6px 10px 6px; }
.informe-cuerpo > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container > * { margin-bottom: 10px; }
.informe-motivo { font-size: 14px; color: var(--rojo-claro); white-space: normal; }
.informe-titulo { font-size: 26px; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; color: var(--pergamino); white-space: normal; margin: 0; }
.informe-titulo--victoria { color: #9ad07a; }
.informe-titulo--derrota { color: #e08a6f; }
.informe-bandos { flex-direction: row; }
.informe-bando { flex-grow: 1; flex-basis: 0; margin: 0 4px; padding: 8px 10px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; background-color: rgba(0, 0, 0, 0.25); }
.informe-bando-titulo { font-size: 11px; letter-spacing: 1px; color: var(--texto-apagado); margin: 0; }
.informe-bando-fuerte { font-size: 15px; color: var(--oro-claro); -unity-font-style: bold; margin: 2px 0; }
.informe-bando-pie { font-size: 12px; color: var(--texto-2); white-space: normal; margin: 0; }
.informe-sub { font-size: 14px; color: var(--oro-claro); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; margin: 4px 0 0 0; }
.informe-tabla { }
.informe-fila { flex-direction: row; align-items: center; padding: 4px 6px; border-bottom-width: 1px; border-color: rgba(107, 74, 41, 0.4); }
.informe-fila--cab Label { color: var(--texto-apagado); font-size: 12px; }
.informe-fila Label { margin: 0; padding: 0; font-size: 13px; }
.informe-col-nombre { flex-grow: 1; flex-basis: 0; }
.informe-col-dueno { width: 110px; color: var(--texto-2); overflow: hidden; }
.informe-col-num { width: 62px; -unity-text-align: middle-right; }
.informe-tropa { flex-direction: row; align-items: center; }
.informe-tropa-nombre { margin-left: 6px; }
.informe-baja { color: #e08a6f; -unity-font-style: bold; }
.informe-heroes { }
.informe-heroe { flex-direction: row; justify-content: space-between; padding: 3px 6px; border-bottom-width: 1px; border-color: rgba(107, 74, 41, 0.4); }
.informe-recuadro { padding: 8px 10px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; background-color: rgba(0, 0, 0, 0.25); }
.informe-recuadro-fuerte { font-size: 14px; -unity-font-style: bold; white-space: normal; margin: 2px 0; }
.informe-recuadro--bueno .informe-recuadro-fuerte { color: #e8c76a; }
.informe-recuadro--malo .informe-recuadro-fuerte { color: #e08a6f; }
.informe-botones { justify-content: flex-end; margin-top: 12px; flex-shrink: 0; }
/* Encima de BattleScene: «Abandonar la batalla», arriba a la derecha. */

/* La barra del jugador (BronzeAgeClient: ui/barraJugador.ts, .jugador-boton): iconos redondos en oro; los demás botones, en un menú. */
.barra-icono { width: 40px; height: 40px; margin-left: 8px; padding: 0; border-width: 1px; border-color: var(--bronce-osc); border-radius: 20px; background-color: rgba(20, 16, 11, 0.88); align-items: center; justify-content: center; }
.barra-icono:hover { border-color: var(--bronce); background-color: rgba(169, 121, 63, 0.2); }
.barra-icono.activo { border-color: var(--oro); background-color: rgba(212, 168, 75, 0.22); }
.barra-cuenta { position: absolute; top: -4px; right: -4px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 9px; background-color: var(--terracota); color: var(--pergamino); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; }
.menu-barra { position: absolute; top: 56px; right: 14px; min-width: 220px; padding: 6px; background-color: var(--marco-bg); border-width: 1px; border-color: var(--bronce); border-radius: 3px; }
.menu-barra-opcion { margin: 0; padding: 8px 12px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 2px; color: var(--pergamino); font-size: 14px; -unity-text-align: middle-left; }
.menu-barra-opcion:hover { background-color: rgba(169, 121, 63, 0.2); color: var(--oro-claro); }
/* Con la Base abierta, la barra solo enseña la Base y los Avisos. */
.barra--base #menu, .barra--base #salir-al-mundo { display: none; }

/* La Base personal (ui/basePersonal.ts, con el marco de la Facción: .faccion-cabecera, .faccion-marco, .faccion-lateral, .base-*). */
.base-ventana { position: absolute; left: 12px; top: 56px; right: 12px; bottom: 12px; padding: 18px 22px 20px 22px; background-color: var(--marco-bg); border-width: 3px; border-color: var(--bronce-osc); border-radius: 3px; }
.base-cabecera { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.base-titulo { font-size: 18px; letter-spacing: 2px; color: var(--oro); margin: 0; }
.base-cerrar { -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-marco { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; }
.base-lateral { width: 25%; min-width: 220px; flex-shrink: 0; margin-right: 18px; padding: 14px 12px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.2); }
.base-principal { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.base-pestanas { flex-direction: row; flex-wrap: wrap; border-bottom-width: 1px; border-color: var(--bronce); margin-bottom: 12px; }
.base-pestana { flex-direction: row; align-items: center; margin: 0 4px -1px 0; padding: 6px 14px; background-color: rgba(0, 0, 0, 0); border-width: 1px 1px 0 1px; border-color: rgba(0, 0, 0, 0); border-radius: 3px 3px 0 0; color: var(--texto-2); font-size: 16px; }
.base-pestana-texto { margin: 0; padding: 0; font-size: 16px; color: var(--texto-2); }
.base-pestana:hover > .base-pestana-texto { color: var(--pergamino); }
.base-pestana.activo > .base-pestana-texto { color: var(--pergamino); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-esc-prestada { margin-right: 14px; }
.base-pestana.activo { color: var(--pergamino); border-color: var(--bronce); background-color: var(--marco-bg-alt); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-pestana-aviso { margin-left: 6px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background-color: var(--terracota); color: var(--pergamino); font-size: 11px; -unity-text-align: middle-center; }
.base-cuerpo { flex-grow: 1; flex-shrink: 1; }

/* El lateral. */
.base-retrato { align-self: stretch; height: 300px; flex-shrink: 0; margin-bottom: 6px; border-width: 1px; border-color: var(--bronce); border-radius: 3px; background-color: rgb(0, 0, 0); align-items: center; justify-content: center; -unity-background-scale-mode: scale-and-crop; }
.base-nivel { position: absolute; right: 8px; bottom: 8px; min-width: 30px; height: 30px; padding: 0 6px; border-width: 1px; border-color: var(--bronce); border-radius: 15px; background-color: var(--marco-bg); color: var(--oro); font-size: 15px; -unity-text-align: middle-center; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.base-nombre { margin: 4px 0 0 0; font-size: 21px; color: var(--oro-claro); white-space: normal; -unity-text-align: middle-center; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.base-donde { margin: 4px 0 0 0; font-size: 14px; color: var(--texto-2); white-space: normal; -unity-text-align: middle-center; }
.base-clase { color: var(--oro); -unity-font-style: italic; }
.base-herido { margin: 6px 0 0 0; font-size: 14px; color: var(--rojo-claro); -unity-text-align: middle-center; }
.base-lateral-pie { margin-top: 14px; padding-top: 14px; border-top-width: 1px; border-color: rgba(169, 121, 63, 0.3); }
.base-dato { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.base-dato-etiqueta { font-size: 14px; color: var(--texto-2); margin: 0; }
.base-dato-valor { font-size: 19px; color: var(--oro); margin: 0; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.base-experiencia { margin-bottom: 10px; }
.base-experiencia > .base-dato { margin-bottom: 3px; }
.base-barra-fondo { height: 7px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.55); border-width: 1px; border-color: rgba(107, 74, 41, 0.8); overflow: hidden; flex-shrink: 0; }
.base-barra-relleno { height: 100%; background-color: rgb(216, 168, 82); }
.base-barra { height: 6px; }
.base-puntos { margin-bottom: 10px; padding: 6px 10px; border-width: 1px; border-color: var(--oro); border-radius: 3px; background-color: rgba(240, 192, 98, 0.12); color: var(--oro-claro); font-size: 14px; }
.base-monedas { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; padding: 6px 8px; border-width: 1px; border-color: rgba(169, 121, 63, 0.35); border-radius: 3px; }
.base-monedas-etiqueta { font-size: 15px; margin: 0; }
.base-monedas-cifra { font-size: 15px; margin: 0; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-dura { margin: -8px 0 10px 0; font-size: 12px; color: var(--texto-2); -unity-text-align: middle-right; }
.base-residencia { padding-top: 8px; border-top-width: 1px; border-color: rgba(169, 121, 63, 0.3); }
.base-lateral-titulo { font-size: 12px; color: var(--texto-2); letter-spacing: 1px; margin: 0; }
.base-residencia-nombre { margin: 4px 0; white-space: normal; font-size: 16px; color: var(--oro-claro); -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.base-residencia .con-icono > Label { flex-shrink: 1; }
.base-boton-chico { align-self: flex-start; padding: 3px 8px; font-size: 12px; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }

/* Tropas. */
.base-titulo-fila { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 2px 0 10px 0; }
.base-kicker-raya { width: 14px; height: 1px; background-color: var(--oro); margin-right: 8px; }
.base-kicker { font-size: 11px; letter-spacing: 3px; color: var(--oro); margin: 0 8px 0 0; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.base-chip { flex-direction: row; align-items: center; margin-left: 6px; padding: 1px 7px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 9px; background-color: rgba(0, 0, 0, 0.35); }
.base-chip > .icono { margin-right: 3px; }
.base-chip-texto { font-size: 12px; color: var(--oro-claro); margin: 0; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-chip-liderazgo > .tropa-tarjeta-liderazgo-icono { width: 12px; height: 12px; margin: 0 3px 0 0; }
.base-pagar-con { flex-direction: row; align-items: center; margin: 0 0 0 10px; }
.base-pagar-con > Label { min-width: 0; font-size: 13px; color: var(--texto-2); margin-right: 6px; }
.base-reponer-prestadas { align-self: flex-start; height: 34px; padding: 0 14px; margin: 0 0 10px 0; font-size: 13px; letter-spacing: 1px; }
.base-riel { flex-shrink: 0; margin-bottom: 12px; }
.base-riel > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-direction: row; }
.base-hueco { width: 110px; height: 174px; margin: 0 8px 0 0; padding: 0; flex-shrink: 0; border-width: 0; border-radius: 3px; background-color: rgba(0, 0, 0, 0); }
.base-hueco .tropa-tarjeta { margin: 0; }
.base-ficha { flex-direction: row; align-items: center; padding: 10px 12px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.22); }
.base-ficha--mermada { border-color: rgba(226, 150, 90, 0.6); }
.base-ficha-cuerpo { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.base-ficha-titulo { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 4px; }
.base-ficha-nombre { font-size: 16px; margin: 0 8px 0 0; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-ficha-titulo > .tropa-estrellas { margin-right: 6px; }
.base-marca { margin: 0 0 0 6px; font-size: 15px; color: var(--oro); -unity-font-style: italic; }
.base-hombres { flex-direction: row; align-items: center; margin-bottom: 4px; }
.base-hombres-barra { width: 90px; margin-right: 8px; }
.base-ficha--mermada .base-hombres-barra > .base-barra-relleno { background-color: rgb(226, 150, 90); }
.base-hombres-cifra { margin: 0 6px 0 0; font-size: 14px; color: var(--pergamino); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-hombres-texto { margin: 0; font-size: 14px; color: var(--texto-2); }
.base-esc-progreso { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 4px; }
.base-esc-nivel { flex-direction: row; align-items: center; margin-right: 14px; }
.base-esc-texto { margin: 0 6px 0 0; font-size: 13px; color: var(--texto-2); }
.base-esc-xp { width: 70px; height: 5px; margin-right: 6px; }
.base-esc-xp > .base-barra-relleno { background-color: rgb(141, 172, 210); }
.base-formacion { margin: 0; min-width: 150px; }
.base-formacion > .unity-base-popup-field__input, .base-pagar-con > .unity-base-popup-field__input { background-color: var(--tinta); border-color: var(--bronce-osc); color: var(--pergamino); font-size: 13px; padding: 2px 6px; }
.base-formacion-texto { margin: 0; font-size: 13px; color: var(--pergamino); }
.base-sitio { margin: 0; font-size: 13px; color: var(--texto-2); }
.base-ficha-acciones { align-items: flex-end; margin-left: 12px; }
.base-reponer { flex-direction: row; align-items: center; height: 34px; padding: 0 10px; margin: 0; font-size: 13px; letter-spacing: 1px; }
.base-reponer > .chip-recurso { margin: 0 0 0 6px; }
.base-vacio { margin: 4px 0; font-size: 13px; color: var(--texto-apagado); }

/* Bienes (htmlCarro). */
.base-bienes { flex-direction: row; align-items: flex-start; }
.base-bienes-carga { flex-grow: 1.3; flex-basis: 0; min-width: 0; margin-right: 18px; }
.base-bienes-resto { flex-grow: 1; flex-basis: 0; }
.base-sub { margin: 4px 0; font-size: 13px; color: var(--pergamino); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-ocupacion { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 6px; }
.base-ocupacion-cifra { margin: 0; font-size: 12px; color: var(--texto-2); }
.base-carro-barra { height: 6px; border-radius: 3px; border-width: 0; background-color: rgba(255, 255, 255, 0.08); margin: 2px 0 8px 0; }
.base-carro-barra--ok > .base-barra-relleno { background-color: rgb(111, 196, 106); }
.base-carro-barra--casi > .base-barra-relleno { background-color: rgb(224, 176, 74); }
.base-carro-barra--llena > .base-barra-relleno { background-color: rgb(224, 112, 90); }
.base-carro-fila { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 6px; }
.base-carro-recurso { flex-grow: 1; }
.base-carro-nombre { margin: 0; font-size: 14px; color: var(--texto-2); }
.base-carro-cifra { margin: 0 8px; font-size: 14px; color: var(--pergamino); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.base-cantidad { width: 84px; margin: 0 8px 0 0; }
.base-cantidad > .unity-base-text-field__input { background-color: var(--tinta); border-color: var(--bronce-osc); color: var(--pergamino); font-size: 13px; padding: 4px 6px; }
.base-boton-fila { padding: 4px 10px; font-size: 13px; }
.base-boton-alineado { align-self: flex-start; margin: 4px 0 8px 0; }
.base-viveres { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 10px; padding: 8px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; }
.base-viveres > .con-icono { flex-grow: 1; }
.base-nota { margin: 6px 0; font-size: 12px; color: var(--texto-2); white-space: normal; }
.base-cuerpo .error { margin-top: 10px; }

/* «Salir al mundo»: ◀ ▶ para el orden de combate, sobre el pie de cada tarjeta. */
.salida-hueco-orden { position: absolute; left: 2px; right: 2px; bottom: 32px; flex-direction: row; justify-content: space-between; }
.salida-hueco-flecha { width: 24px; height: 22px; padding: 0; margin: 0; background-color: rgba(10, 8, 5, 0.72); border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; color: var(--oro-claro); font-size: 11px; -unity-text-align: middle-center; }
.salida-hueco-flecha:hover { border-color: var(--oro); }
.salida-hueco-flecha:disabled { opacity: 0.25; }

/* La Base (2026-11-14, segunda forma): pestañas centradas arriba del todo; Héroe (calco de UIHero_Detail), Tropas (rejilla, modelo y datos como
   UISquadDetail) y Bienes. */
.base-ventana { flex-direction: column; }
.base-cabecera { flex-direction: row; justify-content: center; align-items: flex-end; margin-bottom: 12px; min-height: 40px; }
.base-cabecera > .base-cerrar { position: absolute; right: 0; top: 0; }
.base-pestanas { flex-direction: row; border-bottom-width: 0; margin: 0; }
.base-pestana { margin: 0 18px; padding: 4px 6px 6px 6px; border-width: 0 0 3px 0; border-color: rgba(0, 0, 0, 0); border-radius: 0; background-color: rgba(0, 0, 0, 0); }
.base-pestana > .base-pestana-texto { font-size: 20px; }
.base-pestana.activo { border-color: var(--oro); background-color: rgba(0, 0, 0, 0); }
.base-cuerpo { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; }
.base-bienes-scroll { flex-grow: 1; }
.base-modelo { flex-grow: 1; flex-shrink: 1; min-width: 0; align-self: stretch; -unity-background-scale-mode: scale-to-fit; }

/* Héroe. */
.heroe-col { flex-shrink: 0; padding: 4px 6px; }
.heroe-col--izquierda { width: 26%; min-width: 280px; }
.heroe-col--derecha { width: 22%; min-width: 230px; }
.heroe-estado { margin-bottom: 12px; }
.heroe-estado > .base-nombre { -unity-text-align: middle-left; font-size: 24px; margin: 0; }
.heroe-estado > .base-clase { -unity-text-align: middle-left; margin: 2px 0 8px 0; }
.heroe-atributos { padding: 8px 0; border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(169, 121, 63, 0.3); margin-bottom: 10px; }
.heroe-atributo { flex-direction: row; align-items: center; height: 40px; }
.heroe-atributo-icono { width: 30px; height: 30px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.heroe-atributo-nombre { flex-grow: 1; margin: 0; font-size: 16px; color: var(--pergamino); }
.heroe-atributo-valor { margin: 0; font-size: 20px; color: var(--oro); -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.heroe-puntos { margin: 6px 0 0 0; padding: 6px 10px; border-width: 1px; border-color: var(--oro); border-radius: 3px; background-color: rgba(240, 192, 98, 0.12); color: var(--oro-claro); font-size: 14px; }
.heroe-donde { -unity-text-align: middle-left; margin: 0 0 8px 0; }
.heroe-icono-liderazgo { background-image: url("/Assets/Art/UI/units/leadership.png"); }
.heroe-icono-fuerza { background-image: url("/Assets/Art/UI/strength.png"); }
.heroe-icono-destreza { background-image: url("/Assets/Art/UI/agility.png"); }
.heroe-icono-armadura { background-image: url("/Assets/Art/UI/armor.png"); }
.heroe-icono-dureza { background-image: url("/Assets/Art/UI/thougness.png"); }
.heroe-icono-vida { background-image: url("/Assets/Art/UI/units/hearts.png"); }
.heroe-icono-hombres { background-image: url("/Assets/Art/UI/units/unit-count.png"); }
.heroe-icono-velocidad { background-image: url("/Assets/Art/UI/units/wingfoot.png"); }
.heroe-icono-alcance { background-image: url("/Assets/Art/UI/energy-arrow.png"); }
.heroe-icono-municion { background-image: url("/Assets/Art/UI/units/ammo.png"); }
.heroe-icono-perforante { background-image: url("/Assets/Art/UI/units/piercing.png"); }
.heroe-icono-cortante { background-image: url("/Assets/Art/UI/units/slashing.png"); }
.heroe-icono-contundente { background-image: url("/Assets/Art/UI/units/blunt.png"); }
.heroe-icono-bloqueo { background-image: url("/Assets/Art/UI/shield.png"); }
.heroe-icono-regeneracion { background-image: url("/Assets/Art/UI/units/block_regen.png"); }
.heroe-icono-moral { background-image: url("/Assets/Art/UI/electric.png"); }
.heroe-icono-nivel { background-image: url("/Assets/Art/UI/units/chevron.png"); }
.heroe-equipo-titulo { -unity-text-align: middle-center; margin: 4px 0 10px 0; }
.heroe-equipo { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.heroe-perks { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-bottom: 8px; }
.heroe-perk { width: 92px; align-items: center; margin: 0 4px 6px 4px; }
.heroe-perk-icono { width: 40px; height: 40px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.35); -unity-background-scale-mode: scale-to-fit; }
.heroe-perk-nombre { font-size: 11px; -unity-text-align: upper-center; white-space: normal; margin-top: 2px; color: var(--pergamino); }
.heroe-perk--cerrado { opacity: 0.45; }
.equipo-casilla { width: 48%; align-items: center; margin-bottom: 12px; }
.equipo-cuadro { width: 84px; height: 84px; align-items: center; justify-content: center; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.35); -unity-background-scale-mode: stretch-to-fill; }
.equipo-cuadro--vacio { border-color: rgba(169, 121, 63, 0.35); }
.equipo-rareza-1 { background-image: url("/Assets/Art/UI/common_background_square.png"); }
.equipo-rareza-2 { background-image: url("/Assets/Art/UI/uncommon_background_square (2).png"); }
.equipo-rareza-3 { background-image: url("/Assets/Art/UI/rare_background_square.png"); }
.equipo-rareza-4 { background-image: url("/Assets/Art/UI/epic_background_square.png"); }
.equipo-rareza-5 { background-image: url("/Assets/Art/UI/legendary_background_square.png"); }
.equipo-linea { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; }
.equipo-vacio { margin: 0; font-size: 12px; color: var(--texto-apagado); -unity-text-align: middle-center; }
.equipo-nombre { margin: 4px 0 0 0; font-size: 12px; color: var(--texto-2); white-space: normal; -unity-text-align: upper-center; max-width: 110px; }

/* Tropas. */
.tropas-filtros { width: 52px; flex-shrink: 0; align-items: center; margin-right: 10px; }
.tropas-filtro { width: 44px; height: 44px; margin: 0 0 8px 0; padding: 0; align-items: center; justify-content: center; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.3); }
.tropas-filtro.activo { border-color: var(--oro); background-color: rgba(212, 168, 75, 0.2); }
.tropas-filtros-hueco { flex-grow: 1; }
.tropas-rareza { width: 30px; height: 30px; margin: 0 0 8px 0; padding: 0; border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; background-color: rgba(0, 0, 0, 0.3); }
.tropas-rareza.activo { border-color: var(--oro-claro); border-width: 2px; }
.tropas-panel { width: 440px; flex-shrink: 0; }
.tropas-buscar { margin: 0 0 10px 0; }
.tropas-rejilla { flex-grow: 1; flex-shrink: 1; }
.tropas-rejilla > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; }
.tropas-hueco { width: 96px; height: 152px; margin: 0 8px 8px 0; padding: 0; border-width: 0; border-radius: 3px; background-color: rgba(0, 0, 0, 0); }
.tropas-hueco .tropa-tarjeta { margin: 0; }
.tropas-hueco--vacio { background-image: resource("MundoUI/Iconos/simbolo/hueco"); -unity-background-image-tint-color: rgba(169, 121, 63, 0.35); background-color: rgba(20, 16, 11, 0.35); }
.tropas-pie { flex-direction: row; align-items: center; margin-top: 8px; }
.tropas-orden { flex-grow: 1; margin: 0 8px 0 0; }
.tropas-orden > .unity-base-popup-field__input { background-color: var(--tinta); border-color: var(--bronce-osc); color: var(--pergamino); font-size: 13px; }
.tropas-reponer-prestadas { font-size: 13px; padding: 6px 10px; }
.tropas-datos { width: 23%; min-width: 260px; flex-shrink: 0; }
.tropas-subpestanas { flex-direction: row; justify-content: center; align-items: center; margin-bottom: 10px; }
.tropas-subpestana { margin: 0 8px; padding: 2px 4px 4px 4px; border-width: 0 0 2px 0; border-color: rgba(0, 0, 0, 0); border-radius: 0; background-color: rgba(0, 0, 0, 0); color: var(--texto-2); font-size: 17px; }
.tropas-subpestana.activo { color: var(--pergamino); border-color: var(--oro); }
.tropas-subpestana-raya { margin: 0; color: var(--texto-apagado); font-size: 17px; }
.tropas-contenido { flex-grow: 1; flex-shrink: 1; }
.tropas-cabeza-fila { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.tropas-cabeza { flex-shrink: 1; }
.tropas-nombre { margin: 0; font-size: 22px; color: var(--pergamino); white-space: normal; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.tropas-tipo { margin: 2px 0 6px 0; font-size: 14px; color: var(--texto-2); }
.tropas-estrellas-fila { flex-direction: row; align-items: center; margin-bottom: 10px; }
.tropas-cifras { flex-direction: row; justify-content: space-between; margin: 6px 0 12px 0; }
.tropas-cifra { align-items: center; width: 24%; }
.tropas-cifra-icono { width: 30px; height: 30px; -unity-background-scale-mode: scale-to-fit; margin-bottom: 4px; }
.tropas-cifra-valor { margin: 0; font-size: 16px; color: var(--pergamino); -unity-text-align: middle-center; }
.tropas-cifra > .base-esc-nivel { margin: 4px 0 0 0; flex-direction: column; }
.tropas-cifra .base-esc-xp { width: 64px; margin: 0; }
.tropas-cifra .base-esc-texto { font-size: 11px; margin: 0; -unity-text-align: middle-center; }
.tropas-seccion { margin: 12px 0 8px 0; align-items: center; }
.tropas-seccion-titulo { margin: 0 0 4px 0; font-size: 15px; color: var(--pergamino); -unity-text-align: middle-center; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.tropas-seccion-raya { height: 1px; align-self: stretch; background-color: rgba(169, 121, 63, 0.4); }
.tropas-botones { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.tropas-boton { width: 56px; height: 56px; margin: 0 6px 6px 0; padding: 4px; align-items: center; justify-content: center; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-image: url("/Assets/Art/UI/units/common_background_square.png"); -unity-background-scale-mode: stretch-to-fill; }
.tropas-boton.activo { border-color: var(--oro); border-width: 2px; }
.tropas-boton-icono { width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; }
.tropas-boton-letra { margin: 0; font-size: 20px; color: var(--oro-claro); }
.tropas-elegida { margin: 0 0 4px 0; font-size: 13px; color: var(--texto-2); -unity-text-align: middle-center; }
.tropas-acciones { align-items: flex-start; margin-top: 12px; }
.tropas-atributo { flex-direction: row; align-items: center; height: 26px; }
.tropas-atributo-icono { width: 20px; height: 20px; margin-right: 8px; }
.tropas-atributo-nombre { flex-grow: 1; margin: 0; font-size: 14px; color: var(--texto-2); }
.tropas-atributo-valor { margin: 0; font-size: 14px; color: var(--pergamino); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }

/* Bienes (segunda forma): almacén personal (Objetos | Recursos) a la izquierda, más ancho; Mochila | Carro a la derecha. */
.bienes-panel { flex-shrink: 1; min-width: 0; padding: 10px 12px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.2); }
.bienes-panel--ancho { flex-grow: 1.6; flex-basis: 0; margin-right: 16px; }
.bienes-panel--estrecho { flex-grow: 1; flex-basis: 0; }
.bienes-cuenta { margin: 0 0 8px 0; font-size: 12px; color: var(--texto-2); -unity-text-align: middle-right; }
.bienes-rejilla { flex-direction: row; flex-wrap: wrap; align-self: center; }
.bienes-casilla { width: 56px; height: 56px; margin: 0 4px 4px 0; padding: 0; align-items: center; justify-content: center; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.35); -unity-background-scale-mode: stretch-to-fill; }
.bienes-casilla--vacia { border-color: rgba(169, 121, 63, 0.22); background-color: rgba(0, 0, 0, 0.18); }
.bienes-casilla.activo { border-color: var(--oro-claro); border-width: 2px; }
.bienes-casilla-cantidad { position: absolute; right: 3px; top: 1px; margin: 0; font-size: 11px; color: var(--pergamino); -unity-font-style: bold; }
.bienes-elegido { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 8px; padding: 8px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; }
.bienes-elegido-nombre { flex-grow: 1; margin: 0 8px 0 0; font-size: 14px; color: var(--pergamino); }
.tropas-contenido .con-icono > Label { flex-shrink: 1; white-space: normal; }

/* Las barras de desplazamiento (Víctor, 2026-11-14): sin barra si cabe; si no, finas (6 px), sin flechas, con el riel casi invisible y el asidero
   del bronce del marco, redondeadas. Para todas las pantallas del mundo (más específicas que el tema de Unity). */
.unity-scroll-view .unity-scroller--vertical { width: 6px; min-width: 6px; max-width: 6px; margin-left: 4px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroll-view .unity-scroller--horizontal { height: 6px; min-height: 6px; max-height: 6px; margin-top: 4px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroll-view .unity-scroller__low-button, .unity-scroll-view .unity-scroller__high-button { display: none; }
.unity-scroll-view .unity-scroller .unity-base-slider__input, .unity-scroll-view .unity-scroller .unity-base-slider__drag-container { margin: 0; padding: 0; }
.unity-scroll-view .unity-scroller .unity-base-slider__tracker { background-color: rgba(169, 121, 63, 0.10); border-width: 0; border-radius: 3px; left: 0; right: 0; top: 0; bottom: 0; margin: 0; }
.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger { width: 6px; left: 0; margin: 0; background-color: rgba(169, 121, 63, 0.75); border-width: 0; border-radius: 3px; }
.unity-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger { height: 6px; top: 0; margin: 0; background-color: rgba(169, 121, 63, 0.75); border-width: 0; border-radius: 3px; }
.unity-scroll-view .unity-scroller .unity-base-slider__dragger:hover { background-color: var(--bronce); }
.unity-scroll-view .unity-base-slider__dragger-border { display: none; }
.unity-scroll-view .unity-scroll-view__vertical-scroller { width: 6px; min-width: 6px; max-width: 6px; }
.unity-scroll-view .unity-scroll-view__horizontal-scroller { height: 6px; min-height: 6px; max-height: 6px; }
.unity-scroll-view .unity-scroller .unity-base-slider__drag-container { width: 6px; }

/* Tanda 2: la ficha del objeto (aspecto de las fichas de BronzeAge con los valores de Conquest y la comparación), elegir equipo y repartir puntos. */
Button.equipo-cuadro { padding: 0; margin: 0; }
Button.equipo-cuadro:hover { border-color: var(--oro); }
.objeto-ficha { position: absolute; width: 300px; padding: 12px 14px; background-color: var(--marco-bg-alt); border-width: 1px; border-color: var(--bronce); border-radius: 3px; }
.objeto-ficha-cab { flex-direction: row; align-items: center; margin-bottom: 8px; }
.objeto-ficha-cuadro { width: 56px; height: 56px; margin-right: 10px; flex-shrink: 0; }
.objeto-ficha-textos { flex-shrink: 1; }
.objeto-ficha-nombre { margin: 0; font-size: 15px; color: var(--pergamino); white-space: normal; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.objeto-ficha-rareza { margin: 2px 0 0 0; font-size: 12px; }
.objeto-ficha-tipo { margin: 2px 0 0 0; font-size: 12px; color: var(--texto-2); white-space: normal; }
.objeto-ficha-seccion { margin-top: 6px; padding-top: 6px; border-top-width: 1px; border-color: rgba(169, 121, 63, 0.3); }
.objeto-ficha-seccion-titulo { margin: 0 0 4px 0; font-size: 12px; color: var(--oro); letter-spacing: 1px; }
.objeto-ficha-fila { flex-direction: row; align-items: center; height: 20px; }
.objeto-ficha-icono { width: 16px; height: 16px; margin-right: 6px; }
.objeto-ficha-etiqueta { flex-grow: 1; margin: 0; font-size: 12px; color: var(--texto-2); }
.objeto-ficha-valor { margin: 0; font-size: 12px; color: var(--pergamino); }
.objeto-ficha-dif { margin: 0 0 0 6px; min-width: 34px; font-size: 12px; -unity-text-align: middle-right; color: var(--texto-2); }
.objeto-ficha-dif--mejor { color: var(--verde); }
.objeto-ficha-dif--peor { color: var(--rojo-claro); }
.objeto-ficha-texto { margin: 2px 0 0 0; font-size: 12px; color: var(--pergamino); white-space: normal; }
.objeto-ficha-pie { flex-direction: row; justify-content: space-between; margin-top: 6px; }
.objeto-ficha-compara { margin: 6px 0 0 0; font-size: 11px; color: var(--texto-apagado); -unity-font-style: italic; white-space: normal; }
.elegir-equipo-velo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.elegir-equipo { position: absolute; width: 260px; padding: 10px 12px; background-color: var(--marco-bg-alt); border-width: 1px; border-color: var(--bronce); border-radius: 3px; }
.elegir-equipo-titulo { margin: 0 0 8px 0; }
.elegir-equipo-rejilla { flex-direction: row; flex-wrap: wrap; }
.elegir-equipo-quitar { align-self: flex-start; margin-top: 6px; }
.heroe-reparto { width: 24px; height: 24px; margin: 0 0 0 6px; padding: 0; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.3); color: var(--oro-claro); font-size: 15px; -unity-text-align: middle-center; }
.heroe-reparto:hover { border-color: var(--oro); }
.heroe-reparto:disabled { opacity: 0.25; }
.heroe-atributo-valor--nuevo { color: var(--verde); }
.heroe-reparto-botones { flex-direction: row; align-items: center; margin-top: 8px; }
.heroe-reparto-botones > .boton-primario { margin: 0 8px 0 0; }

/* Loadouts (tanda 2): la lista a la izquierda y el elegido a la derecha, con el riel de tarjetas grandes. */
.loadouts-lista { flex-grow: 0; width: 26%; min-width: 260px; margin-right: 16px; }
.loadouts-editor { flex-grow: 1; flex-basis: 0; }
.loadouts-titulo { margin: 0 0 10px 0; }
.loadouts-fila { margin: 0 0 6px 0; padding: 8px 10px; align-items: flex-start; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(0, 0, 0, 0.25); }
.loadouts-fila:hover { border-color: var(--bronce); }
.loadouts-fila.activo { border-color: var(--oro); background-color: rgba(212, 168, 75, 0.12); }
.loadouts-nombre { margin: 0; font-size: 15px; color: var(--pergamino); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.loadouts-datos { flex-direction: row; align-items: center; margin-top: 2px; }
.loadouts-detalle { margin: 0; font-size: 12px; color: var(--texto-2); }
.loadouts-nuevo { align-self: flex-start; margin-top: 4px; }
.loadouts-cab { flex-direction: row; align-items: center; margin-bottom: 12px; }
.loadouts-campo { width: 260px; margin: 0 14px 0 0; }
.loadouts-riel { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.loadouts-hueco { width: 132px; height: 209px; margin: 0 10px 10px 0; flex-shrink: 0; border-radius: 3px; }
.loadouts-hueco .tropa-tarjeta { margin: 0; }
.loadouts-mas { width: 132px; height: 209px; margin: 0 10px 10px 0; }
.loadouts-botones { flex-direction: row; align-items: center; margin: 6px 0 8px 0; }
.loadouts-botones > .boton-primario { margin: 0 8px 0 0; }
.loadouts-botones > .boton-secundario { margin-right: 8px; }

/* La tropa del campamento (paso 6, tanda 3): el árbol de reclutamiento del prototipo (`arbolTablero`, `.ta-*`) con la tarjeta de Conquest en cada
   nudo, y la ficha de la tropa (el panel derecho de Tropas de la Base). */
.recl-velo { align-items: stretch; justify-content: flex-start; }
.recl-ventana { top: 12px; }
.recl-cabecera { flex-direction: row; align-items: center; margin-bottom: 8px; min-height: 40px; }
.recl-chips { margin-left: 16px; }
.recl-hueco { flex-grow: 1; }
.recl-mandos { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 6px; }
.recl-boton-todas { flex-direction: row; align-items: center; margin: 0 16px 0 0; padding: 6px 12px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgb(29, 22, 16); }
.recl-boton-todas:hover { border-color: var(--bronce); }
.recl-boton-todas.activo { border-color: var(--oro); }
.recl-boton-todas.activo > .recl-boton-texto { color: var(--oro-claro); }
.recl-caja { width: 12px; height: 12px; margin: 0 8px 0 0; padding: 0; border-width: 1px; border-color: var(--pergamino); border-radius: 2px; font-size: 10px; -unity-text-align: middle-center; color: var(--oro-claro); }
.recl-boton-texto { margin: 0; font-size: 13px; color: var(--pergamino); }
.recl-ayuda { margin: 0; font-size: 12px; color: var(--texto-apagado); flex-shrink: 1; white-space: normal; }
.recl-leyenda { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 8px; }
.recl-leyenda-item { flex-direction: row; align-items: center; margin-right: 18px; }
.recl-leyenda-item > VisualElement { margin-right: 7px; }
.recl-leyenda-texto { margin: 0 18px 0 0; font-size: 12px; color: var(--texto-2); }
.recl-leyenda-item > .recl-leyenda-texto { margin-right: 0; }
.recl-muestra { width: 22px; height: 14px; border-width: 1px; border-radius: 2px; border-color: var(--bronce-osc); background-color: rgba(70, 52, 30, 0.97); }
.recl-muestra.lista, .recl-muestra.tuya { border-color: var(--oro); background-color: rgba(110, 82, 42, 0.97); }
.recl-muestra.edificio, .recl-muestra.bloqueada, .recl-muestra.futura { border-color: rgba(107, 74, 41, 0.55); background-color: rgba(20, 16, 11, 0.78); }
.recl-cuerpo { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; }
.recl-marco { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 16px; border-width: 1px; border-color: var(--bronce); border-radius: 3px; background-color: var(--marco-panel); }
.recl-era-fondo.par { background-color: rgba(169, 121, 63, 0.04); }
.recl-era-fondo.raya { border-left-width: 1px; border-color: rgba(169, 121, 63, 0.3); }
.recl-era-fondo.futura { background-color: rgba(0, 0, 0, 0.22); }
.recl-carril-fondo { border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(107, 74, 41, 0.45); background-color: rgba(241, 220, 174, 0.022); }
.recl-carril-fondo.par { background-color: rgba(241, 220, 174, 0.045); }
.recl-esquina, .recl-carril-nombre { background-color: var(--marco-bg-alt); border-right-width: 1px; border-color: var(--bronce-osc); }
.recl-esquina { border-bottom-width: 1px; border-bottom-color: var(--bronce); justify-content: flex-end; padding: 0 12px 12px 12px; background-color: var(--marco-bg); }
.recl-esquina-texto { margin: 0; font-size: 10.5px; letter-spacing: 1.6px; color: var(--texto-apagado); white-space: normal; }
.recl-carril-nombre { justify-content: center; padding: 10px 12px; }
.recl-carril-texto { margin: 6px 0 0 0; font-size: 12.5px; letter-spacing: 0.8px; color: var(--oro-claro); white-space: normal; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.recl-carril-sub { margin: 4px 0 0 0; font-size: 11px; color: var(--texto-apagado); }
.recl-era-cab { flex-direction: row; align-items: center; padding: 8px 2px 8px 2px; border-bottom-width: 1px; border-color: var(--bronce); background-color: var(--marco-panel); }
.recl-era-num { width: 46px; height: 46px; flex-shrink: 0; margin: 0 12px 0 0; padding: 0; border-radius: 23px; border-width: 2px; border-color: var(--bronce-osc); background-color: var(--oro); color: rgb(32, 21, 9); font-size: 18px; -unity-text-align: middle-center; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.recl-era-textos { flex-shrink: 1; }
.recl-era-nombre { margin: 0; font-size: 15px; color: var(--oro-claro); white-space: normal; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.recl-era-sub { margin: 3px 0 0 0; font-size: 11.5px; color: var(--texto-2); white-space: normal; }
.recl-era-marca { align-self: flex-start; margin: 4px 0 0 0; padding: 1px 6px; border-radius: 2px; font-size: 9.5px; letter-spacing: 1.3px; }
.recl-era-marca.actual { color: rgb(16, 32, 12); background-color: var(--verde); }
.recl-era-marca.futura { color: var(--texto-2); border-width: 1px; border-color: var(--bronce-osc); }
.recl-carta { margin: 0; padding: 4px; align-items: center; justify-content: flex-start; border-width: 1px; border-radius: 3px; border-color: var(--bronce-osc); background-color: rgba(70, 52, 30, 0.97); }
.recl-carta .tropa-tarjeta { margin: 0; }
.recl-carta.lista, .recl-carta.tuya { border-color: var(--oro); background-color: rgba(110, 82, 42, 0.97); }
.recl-carta.edificio, .recl-carta.bloqueada, .recl-carta.futura { border-color: rgba(107, 74, 41, 0.55); background-color: rgba(20, 16, 11, 0.78); }
.recl-carta.futura { opacity: 0.72; }
.recl-carta.edificio .tropa-tarjeta, .recl-carta.bloqueada .tropa-tarjeta, .recl-carta.futura .tropa-tarjeta { opacity: 0.6; }
.recl-carta:hover, .recl-carta.foco { border-color: var(--oro); }
.recl-carta.elegida { border-width: 2px; border-color: var(--oro-claro); }
.recl-tablero.activo .recl-carta { opacity: 0.3; }
.recl-tablero.activo .recl-carta.baja { opacity: 0.7; }
.recl-tablero.activo .recl-carta.luz { opacity: 1; }
.recl-medalla { position: absolute; top: 1px; right: 1px; width: 18px; height: 18px; margin: 0; padding: 0; border-radius: 9px; align-items: center; justify-content: center; background-color: var(--oro); color: rgb(32, 21, 9); font-size: 11px; -unity-text-align: middle-center; -unity-font-style: bold; }
.recl-carta-estado { margin: 3px 0 0 0; padding: 0; width: 100%; height: 30px; font-size: 10.5px; color: var(--texto-2); white-space: normal; -unity-text-align: upper-center; overflow: hidden; }
.recl-carta.lista .recl-carta-estado, .recl-carta.tuya .recl-carta-estado { color: var(--oro-claro); }
.recl-carta-nombre { margin: 0; font-size: 12px; color: var(--oro-claro); white-space: normal; }
.recl-ficha { min-width: 300px; }
.recl-ficha-estado { margin: 0 0 6px 0; padding: 7px 9px; border-width: 1px; border-radius: 2px; border-color: var(--bronce-osc); background-color: rgba(0, 0, 0, 0.25); font-size: 13px; color: var(--pergamino); white-space: normal; }
.recl-ficha-estado.lista, .recl-ficha-estado.tuya { border-color: var(--oro); }
.recl-tip { position: absolute; width: 380px; padding: 12px 14px; border-width: 1px; border-radius: 2px; border-color: var(--bronce); background-color: var(--marco-bg-alt); }
.recl-tip-cab { flex-direction: row; align-items: center; margin-bottom: 6px; }
.recl-tip-cab > .tropa-mini { margin-right: 10px; flex-shrink: 0; }
.recl-tip-textos { flex-shrink: 1; }
.recl-tip-nombre { margin: 0; font-size: 16px; color: var(--oro-claro); white-space: normal; -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; }
.recl-tip-meta { margin: 0; font-size: 12px; color: var(--texto-apagado); white-space: normal; }
.recl-tip-estado { margin: 8px 0 2px 0; padding: 7px 9px; border-width: 1px; border-radius: 2px; border-color: var(--bronce-osc); background-color: rgba(0, 0, 0, 0.25); }
.recl-tip-estado.lista, .recl-tip-estado.tuya { border-color: var(--oro); }
.recl-tip-texto { margin: 2px 0 0 0; font-size: 12.5px; color: var(--pergamino); white-space: normal; }
.recl-tip-seccion { margin: 11px 0 4px 0; font-size: 10.5px; letter-spacing: 1.6px; color: var(--oro); }
.recl-carta .tropa-tarjeta-cifra, .recl-carta .tropa-tarjeta-hombres { font-size: 12px; }
/* «Adoptable» en el árbol de tropas (paso 8, tanda 3): solo falta adoptar su tecnología; la etiqueta «Adoptar» abre la pestaña Tecnología. */
.recl-carta.adoptable { border-color: #7fcf6a; }
.recl-carta.adoptable .recl-medalla { background-color: #7fcf6a; color: rgb(16, 32, 12); }
.recl-muestra.adoptable { border-color: #7fcf6a; background-color: rgba(20, 16, 11, 0.78); }
.recl-carta-estado--adoptar { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: center; }
.recl-carta-estado-texto { margin: 0 0 0 4px; padding: 0; font-size: 10.5px; color: var(--texto-2); white-space: normal; flex-shrink: 1; }
.recl-boton-mini { margin: 0; padding: 0 7px; height: 16px; border-width: 1px; border-color: rgb(122, 86, 38); border-radius: 2px; background-color: var(--oro); color: rgb(32, 21, 9); font-size: 9.5px; letter-spacing: 0.8px; -unity-font-style: bold; -unity-text-align: middle-center; }
Button.recl-boton-mini:hover { background-color: var(--oro-claro); }
.recl-tip-tec { flex-direction: row; align-items: flex-start; }
.recl-tip-marca { width: 14px; margin: 2px 4px 0 0; padding: 0; font-size: 12.5px; -unity-font-style: bold; }
.recl-tip-marca.ok { color: #7fcf6a; }
.recl-tip-marca.ap { color: #e0a53a; }
.recl-tip-marca.no { color: #e2675a; }
.recl-tip-tec > .recl-tip-texto { flex-shrink: 1; }
/* La ventana «Opciones» (Víctor, 2026-11-15): secciones y filas de `OpcionesDelJuego`. */
.opciones-ventana { width: 560px; max-width: 92%; }
.opciones-cabecera { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.opciones-cabecera > .dialogo-titulo { margin-bottom: 0; }
.opciones-fila { margin: 6px 0 10px 0; padding: 10px 12px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: rgba(255, 255, 255, 0.035); }
.opciones-ayuda { margin: 6px 0 0 0; font-size: 13px; color: var(--texto-2); white-space: normal; }

/* ─────────── El mapa estratégico 2D (paso 9): `.mapa-interior` del prototipo, a toda la ventana, encima de la barra y del HUD ─────────── */
.mapa-interior { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(10, 14, 23); overflow: hidden; }
.mapa-lienzo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; cursor: grab; }
.mapa-lienzo.arrastrando { cursor: grab; }
.mapa-lienzo.eligiendo { cursor: crosshair; }
#mapa-suelo, #mapa-niebla, #mapa-fertilidad { -unity-background-scale-mode: stretch-to-fill; }
.mapa-cosa { position: absolute; -unity-background-scale-mode: scale-to-fit; overflow: visible; }
.mapa-plaza { position: absolute; -unity-background-scale-mode: scale-to-fit; }
.mapa-plaza-punto { border-width: 1.5px; border-radius: 6px; }
.mapa-cosa-nombre {
    position: absolute; left: -60px; right: -60px; font-size: 11px; color: #f4ead2; -unity-text-align: upper-center;
    -unity-text-outline-width: 0.3px; -unity-text-outline-color: rgba(10, 14, 23, 0.8); text-shadow: 0 0 3px rgba(10, 14, 23, 0.9);
    padding: 0; margin: 0;
}
.mapa-cosa-cuenta {
    position: absolute; font-size: 11px; -unity-font-style: bold; color: #f4ead2; padding: 0; margin: 0;
    text-shadow: 0 0 3px rgba(10, 14, 23, 0.9);
}
.mapa-interior-cerrar {
    position: absolute; top: 14px; right: 16px; width: 36px; height: 36px; padding: 0; margin: 0; font-size: 18px;
    background-color: #1d1610; color: var(--pergamino); border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px;
}
.mapa-interior-cerrar:hover { border-color: var(--bronce); color: var(--oro-claro); }
.mapa-zoom {
    position: absolute; right: 16px; bottom: 20px; flex-direction: column; border-width: 1px; border-color: var(--bronce); border-radius: 3px;
    background-color: var(--marco-bg); overflow: hidden;
}
.mapa-zoom Button {
    width: 38px; height: 38px; margin: 0; padding: 0; font-size: 19px; border-width: 0; border-radius: 0;
    background-color: var(--marco-bg-alt); color: var(--pergamino);
}
.mapa-zoom Button:hover { color: var(--oro-claro); background-color: #2c2117; }
#zoom-mas { border-bottom-width: 1px; border-color: var(--bronce-osc); }
.mapa-capas { position: absolute; left: 16px; bottom: 16px; flex-direction: row; align-items: flex-end; }
.mapa-capas-boton {
    width: 40px; height: 40px; margin: 0; padding: 0; align-items: center; justify-content: center; border-radius: 3px;
    background-color: var(--marco-bg-alt); border-width: 1px; border-color: var(--bronce); color: var(--pergamino);
}
.mapa-capas-boton:hover, .mapa-capas-boton.activo { border-color: var(--oro); }
.mapa-capas-lista {
    position: absolute; left: 48px; bottom: 0; width: 248px; padding: 10px 12px; border-width: 1px; border-color: var(--bronce); border-radius: 3px;
    background-color: var(--marco-bg); color: var(--pergamino); font-size: 13px;
}
.mapa-capas-titulo { font-size: 11px; letter-spacing: 1.5px; color: var(--oro); -unity-font-style: bold; margin: 0 0 6px 0; padding: 0; }
.mapa-capas-fila { margin: 0; padding: 3px 0; flex-direction: row; align-items: center; }
.mapa-capas-fila Label { color: var(--pergamino); font-size: 13px; }
.mapa-capas-fila .con-icono { margin-left: 8px; }
.mapa-capas-fila .con-icono Label { font-size: 13px; color: var(--pergamino); margin-left: 4px; }
.mapa-capas-leyenda { padding: 0 0 4px 23px; }
.mapa-capas-rampa { height: 9px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; margin-top: 2px; }
.mapa-capas-corte { position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; background-color: var(--pergamino); }
.mapa-capas-extremos { flex-direction: row; justify-content: space-between; margin-top: 3px; }
.mapa-capas-extremos Label { font-size: 11px; color: var(--texto-2); padding: 0; margin: 0; }
.mapa-capas-nota { font-size: 11px; color: var(--texto-2); margin: 4px 0 0 0; padding: 0; white-space: normal; }
.mapa-eleccion {
    position: absolute; top: 14px; left: 50%; translate: -50% 0; max-width: 560px; padding: 8px 14px; border-width: 1px; border-color: var(--oro);
    border-radius: 4px; background-color: rgba(20, 16, 12, 0.92); align-items: center;
}
.mapa-eleccion Label { white-space: normal; -unity-text-align: middle-center; color: var(--pergamino); font-size: 14px; }
.mapa-eleccion-error { color: var(--rojo-claro); margin-top: 4px; }

/* ─────────── Paso 9, tanda 2: la puerta desde la ficha del mapa y la capa de parcelas ─────────── */
.ficha-extra { margin-top: 4px; }
.obra-entrega { margin-bottom: 4px; }
.obra-entrega-total { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 3px; }
.obra-entrega-titulo { margin: 0 0 0 4px; padding: 0; font-size: 13px; color: var(--pergamino); -unity-font-style: bold; }
.obra-entrega-pct { margin: 0 0 0 4px; padding: 0; font-size: 13px; color: var(--oro-claro); -unity-font-style: bold; }
.obra-entrega-fila { flex-direction: row; align-items: center; margin-top: 4px; }
.obra-entrega-fila > * { margin-right: 6px; }
.obra-entrega-nombre { width: 64px; flex-shrink: 0; margin: 0; padding: 0; font-size: 12px; color: var(--texto-2); }
.obra-entrega-fila > .plaza-barra-avance { flex-grow: 1; min-width: 40px; }
.obra-entrega-cifra { margin: 0 6px 0 0; padding: 0; font-size: 12px; color: var(--pergamino); }
.obra-entrega-falta { margin: 0; padding: 0; font-size: 11.5px; color: #ffd590; }
.obra-entrega-fila.lista .obra-entrega-falta { color: #9fd49a; }
.obra-entrega-lleva { margin-left: 2px; }
.obra-entrega-lleva-n { margin: 0 0 0 2px; padding: 0; font-size: 11.5px; }
.obra-entrega-lleva.alcanza .obra-entrega-lleva-n { color: #9fd49a; }
.obra-entrega-lleva.parte .obra-entrega-lleva-n { color: #ffd590; }
.obra-entrega-lleva.nada .obra-entrega-lleva-n { color: var(--texto-apagado); }
.obra-entrega-acciones { flex-direction: row; justify-content: flex-end; margin-top: 8px; }
.ventana-puerta { position: absolute; right: 360px; bottom: 16px; width: 360px; max-height: 70%; }
.ventana-puerta.ancha { width: 900px; }
.ventana-puerta-filete { padding: 14px 16px; }
.ventana-puerta-cab { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.ventana-puerta-cuerpo { flex-shrink: 1; }
.puerta-escuadra { flex-direction: row; align-items: center; padding: 5px 0; border-bottom-width: 1px; border-color: rgba(107, 74, 41, 0.5); }
.puerta-escuadra > * { margin-right: 8px; }
.puerta-escuadra-texto { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.puerta-cupo { margin-bottom: 6px; }
.puerta-cupo-cab { flex-direction: row; justify-content: space-between; align-items: center; }
.puerta-cupo-n { margin: 0; padding: 0; font-size: 12px; color: var(--oro-claro); }
.puerta-sub { margin-top: 8px; }
.puerta-carga { flex-direction: row; align-items: center; margin-top: 5px; }
.puerta-carga > * { margin-right: 6px; }
.puerta-carga > .con-icono { flex-grow: 1; }
.puerta-carga-nombre { margin: 0 0 0 4px; padding: 0; font-size: 12.5px; color: var(--pergamino); }
.puerta-carga-lleva { margin: 0; padding: 0; font-size: 12px; color: var(--texto-2); }
.puerta-carga-cantidad { width: 64px; margin: 0; }
.mapa-capas-muestra { flex-direction: row; align-items: center; margin: 1px 0; }
.mapa-capas-muestra > Label { margin: 0 0 0 7px; padding: 0; font-size: 12px; color: var(--pergamino); }
.mapa-capas-muestra-punto { width: 11px; height: 11px; border-width: 1.5px; border-radius: 6px; }

.ficha-extra .plaza-nota { white-space: normal; }
.obra-entrega-fila > .plaza-barra-avance { margin-top: 0; }

/* Las casillas de las capas: sin el hueco de la etiqueta del campo; la casilla y su texto pegados a la izquierda. */
.mapa-capas-fila > .unity-base-field__label { display: none; }
.mapa-capas-fila > .unity-base-field__input { flex-grow: 0; }
.mapa-capas-fila > .con-icono { margin-left: 6px; }

/* paso 11, tanda 1: salir como ejército */
.salida-modos { margin: 0; padding: 0; }
.salida-modos RadioButton { margin: 2px 0; }
.salida-modos .unity-radio-button__checkmark-background { border-width: 1px; border-color: var(--bronce); background-color: var(--tinta); }
.salida-modos .unity-radio-button__checkmark { background-color: var(--oro); }
.salida-ejercito { margin-top: 6px; padding-top: 6px; border-top-width: 1px; border-top-color: rgba(107, 74, 41, 0.6); }
.salida-ejercito > * { margin-bottom: 4px; }
.salida-recuadro-sub { margin: 6px 0 2px 0; font-size: 12px; letter-spacing: 1px; color: var(--texto-2); -unity-font-style: bold; }
.ejercito-fila { flex-direction: row; align-items: center; padding: 6px 8px; border-width: 1px; border-color: rgba(107, 74, 41, 0.7); border-radius: 3px; background-color: rgba(18, 14, 9, 0.9); margin-bottom: 4px; }
.ejercito-fila-texto { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.ejercito-fila > Button { margin-left: 6px; }
.conv-integrantes > .conv-integrante { margin-bottom: 6px; }
.conv-integrante { padding: 6px 8px; border-width: 1px; border-color: rgba(107, 74, 41, 0.6); border-radius: 3px; background-color: rgba(0, 0, 0, 0.3); }
.conv-integrante-cab { flex-direction: row; align-items: center; }
.conv-integrante-cab > * { margin-right: 8px; }
.conv-papel { margin: 0; padding: 1px 6px; border-radius: 8px; background-color: rgba(98, 74, 31, 0.9); font-size: 11px; color: var(--oro-claro); }
.conv-integrante-tropas { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.conv-integrante-tropas > * { margin-right: 4px; }
.conv-caravanas { flex-direction: row; flex-wrap: wrap; }
.conv-caravana { flex-direction: row; align-items: center; width: 220px; margin: 0 6px 6px 0; padding: 6px; border-width: 1px; border-color: rgba(107, 74, 41, 0.7); border-radius: 3px; background-color: rgba(18, 14, 9, 0.9); -unity-text-align: upper-left; }
.conv-caravana.elegida { border-color: var(--oro); background-color: rgba(52, 37, 19, 0.95); }
.conv-caravana > VisualElement { margin-right: 8px; }
.salida-salir.salida-ejercito-boton { width: auto; padding: 0 18px; margin-left: 8px; }

/* Paso 11, tanda 2: el riel del mapa (⚑ Ejército), centrado abajo como `.mapa-abajo .mapa-riel`, y la ventana Ejército centrada
   (`.mapa-panel-ventana`, hasta 960 px). */
.mapa-riel { position: absolute; left: 50%; bottom: 40px; translate: -50% 0; flex-direction: row; border-width: 1px; border-color: rgb(169, 121, 63); border-radius: 3px; background-color: rgb(23, 17, 12); }
.mapa-riel-boton { width: 44px; height: 44px; margin: 0; padding: 0; border-width: 0; border-radius: 0; align-items: center; justify-content: center; background-color: rgb(30, 23, 16); }
.mapa-riel-boton:hover { background-color: rgb(50, 38, 24); }
.mapa-riel-boton.activo { background-color: rgba(169, 121, 63, 0.32); }
.ventana-ejercito { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 960px; max-width: 94%; max-height: 80%; }
.ejercito-cab-textos { flex-grow: 1; }
.ejercito-cuerpo { flex-direction: row; flex-shrink: 1; }
.ejercito-col { flex-grow: 1; flex-basis: 0; flex-shrink: 1; margin-right: 18px; }
.ejercito-col:last-child { margin-right: 0; }
.ejercito-acciones { flex-direction: row; flex-wrap: wrap; margin: 6px 0; }
.ejercito-acciones > Button { margin: 0 8px 6px 0; height: 32px; padding: 0 14px; }
.ejercito-recursos { flex-direction: row; flex-wrap: wrap; }
.ejercito-recursos > * { margin-right: 12px; }
.ventana-ejercito .ejercito-fila > Button { height: 32px; padding: 0 12px; margin-left: 6px; }
.ventana-ejercito .tropas-orden { flex-grow: 1; margin: 0; }
.unirse-fila > .ejercito-fila-texto { flex-grow: 1; margin-left: 8px; }
.ejercito-caravana { padding: 6px 8px; margin-bottom: 6px; border-width: 1px; border-color: rgba(107, 74, 41, 0.6); border-radius: 3px; background-color: rgba(0, 0, 0, 0.3); }
.ejercito-cargar { flex-direction: row; align-items: center; margin-top: 6px; }
.ejercito-cargar > .tropas-orden { flex-grow: 1; flex-shrink: 1; margin: 0 6px 0 0; }
.ejercito-cantidad { width: 70px; margin: 0 6px 0 0; }
.ejercito-cargar > Button { height: 30px; padding: 0 10px; margin: 0; }
.ejercito-cantidad > .unity-base-text-field__input { height: 30px; padding: 0 6px; background-color: var(--tinta); border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; color: var(--pergamino); font-size: 14px; -unity-text-align: middle-right; }

/* La crónica del mundo (paso 13, tanda 2; los .cronica-* de BronzeAgeClient), en el panel lateral de los Avisos. */
.cronica-entrada { flex-direction: row; align-items: flex-start; margin-bottom: 6px; padding: 6px 8px; border-left-width: 2px; border-color: rgba(0, 0, 0, 0); border-radius: 2px; background-color: rgba(0, 0, 0, 0.2); }
.cronica-entrada.es-propia { border-left-color: var(--oro); background-color: rgba(216, 184, 120, 0.1); }
.cronica-icono { width: 26px; height: 26px; flex-shrink: 0; margin-right: 8px; align-items: center; justify-content: center; border-width: 1px; border-color: var(--bronce-osc); border-radius: 13px; background-color: rgba(0, 0, 0, 0.35); }
.cronica-punto { margin: 0; color: var(--bronce); }
.cronica-texto { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.cronica-frase { margin: 0; font-size: 13.5px; color: var(--pergamino); white-space: normal; }
.cronica-fecha { margin: 2px 0 0 0; font-size: 11.5px; color: var(--texto-apagado); }
.cronica-mas { margin-top: 8px; height: 32px; }

/* Defender tu plaza (tanda 3 del motor c94a960): el aviso arriba en la plaza y el panel de elegidas, con el riel de la salida. */
.plaza-asedio { position: absolute; top: 140px; left: 50%; translate: -50% 0; flex-direction: row; align-items: center; padding: 6px 8px 6px 14px;
    background-color: var(--marco-bg); border-width: 1px; border-color: var(--rojo-claro); border-radius: 3px; }
.plaza-asedio-texto { color: var(--rojo-claro); font-size: 15px; -unity-font-style: bold; margin-right: 14px; }
.plaza-asedio-boton { margin: 0; }
.defensa-ventana { width: 860px; max-width: 94%; height: auto; padding-bottom: 14px; }
.defensa-tropa { padding: 10px 4px; }
.defensa-liderazgo { flex-direction: row; align-items: center; margin-left: auto; }
.defensa-icono { width: 22px; height: 22px; margin-right: 6px; }
.defensa-icono-chico { width: 14px; height: 14px; margin-right: 3px; }
.defensa-riel { flex-wrap: wrap; margin-top: 10px; }
.defensa-fuera { margin-top: 10px; }
.defensa-acciones { flex-direction: row; align-items: center; justify-content: flex-end; }
.defensa-boton { margin-left: 12px; }
