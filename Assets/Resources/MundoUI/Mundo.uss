/* «Bronce y arcilla» (BronzeAgeClient: docs/Diseno_Interfaz.md y src/style.css) en USS, para las pantallas de fuera de la batalla.
   USS no tiene degradados ni sombras: la placa de bronce se hace con bordes (banda de bronce oscuro y filete de bronce). Usa los tokens, no
   metas colores sueltos. Los titulares van en versales escritas como tales (USS no tiene text-transform). Letras del prototipo (SIL OFL,
   en Fuentes/): Inter para el texto y Cinzel para titulares, nombres y la acción principal. */
:root {
    --tinta: #0b0805;
    --marco-bg: #191410;
    --marco-bg-alt: #221a12;
    --marco-panel: #14100c;
    --bronce: #a9793f;
    --bronce-osc: #6b4a29;
    --oro: #d8b878;
    --oro-claro: #f1dcae;
    --terracota: #bf5233;
    --pergamino: #ede0c4;
    --texto-2: #b8ab92;
    --texto-apagado: #8a7d66;
    --verde: #8fc79f;
    --rojo-claro: #f0a58f;
    color: var(--pergamino);
    font-size: 16px;
    -unity-font: url("Fuentes/Inter-Regular.ttf");
    -unity-font-definition: initial;
}

.fondo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--tinta); align-items: center; justify-content: center; }

/* La placa de bronce: banda oscura, filete de bronce y fondo cálido. */
.placa {
    background-color: var(--marco-bg-alt);
    border-width: 4px; border-color: var(--bronce-osc); border-radius: 3px;
}
.placa-filete { border-width: 1px; border-color: var(--bronce); border-radius: 1px; padding: 28px 30px; background-color: var(--marco-bg); }

.tarjeta { width: 460px; }
.tarjeta-ancha { width: 620px; }

.titulo { font-size: 28px; -unity-font-style: bold; color: var(--oro-claro); letter-spacing: 6px; -unity-text-align: middle-center; }
.subtitulo { font-size: 14px; color: var(--texto-2); -unity-text-align: middle-center; margin-top: 4px; margin-bottom: 18px; }
.kicker { font-size: 12px; -unity-font-style: bold; color: var(--oro); letter-spacing: 5px; margin-top: 14px; margin-bottom: 6px; }
.denticulo { height: 3px; margin-bottom: 14px; border-top-width: 1px; border-bottom-width: 1px; border-color: var(--bronce-osc); opacity: 0.7; }

/* Botones: el primario es la placa de oro (uno por pantalla); el secundario, bronce oscuro. */
Button { margin: 0; }
.boton-primario {
    background-color: var(--oro); color: #201509; -unity-font-style: bold; letter-spacing: 3px; font-size: 15px;
    border-width: 1px; border-color: var(--oro-claro); border-bottom-color: #8f6a35; border-radius: 3px;
    height: 44px; margin-top: 12px;
    transition-property: translate, background-color; transition-duration: 0.12s;
}
.boton-primario:hover { background-color: var(--oro-claro); translate: 0 -1px; }
.boton-primario:active { translate: 0 1px; }
.boton-primario:disabled { opacity: 0.55; }
.boton-secundario {
    background-color: #1d1610; color: var(--pergamino); border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px;
    padding: 6px 14px; font-size: 14px;
}
.boton-secundario:hover { border-color: var(--bronce); color: var(--oro-claro); }
.boton-peligro { background-color: var(--terracota); border-color: var(--terracota); color: var(--pergamino); }
.enlace { background-color: rgba(0, 0, 0, 0); border-width: 0; color: var(--oro); font-size: 13px; padding: 4px 0; -unity-text-align: middle-left; }
.enlace:hover { color: var(--oro-claro); }

/* Pestañas Entrar / Crear cuenta */
.pestanas { flex-direction: row; padding: 3px; margin-bottom: 18px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px; background-color: var(--marco-panel); }
.pestana { flex-grow: 1; flex-basis: 0; height: 34px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: var(--texto-2); font-size: 14px; -unity-font-style: bold; }
.pestana:hover { color: var(--pergamino); }
.pestana--activa { background-color: #3a2c1a; color: var(--oro); border-width: 1px; border-color: var(--bronce); }

/* Formularios */
.campo { margin-bottom: 12px; }
.etiqueta { font-size: 13px; color: var(--texto-2); margin-bottom: 4px; }
.entrada { margin: 0; }
.entrada > .unity-text-field__input, .entrada > .unity-base-text-field__input {
    background-color: var(--tinta); border-width: 1px; border-color: var(--bronce-osc); border-radius: 3px;
    color: var(--pergamino); font-size: 15px; padding: 8px 10px; height: 38px;
}
.entrada:focus > .unity-text-field__input, .entrada:focus > .unity-base-text-field__input { border-color: var(--oro); }
.campo--error .unity-base-text-field__input { border-color: var(--terracota); }
.campo-error { font-size: 12px; color: var(--rojo-claro); margin-top: 3px; white-space: normal; }
.campo-ayuda { font-size: 12px; color: var(--texto-apagado); margin-top: 3px; white-space: normal; }
.oculto { display: none; }

.error { background-color: rgba(191, 82, 51, 0.18); border-width: 1px; border-color: var(--terracota); border-radius: 3px; color: var(--rojo-claro); padding: 8px 12px; margin-bottom: 12px; white-space: normal; font-size: 14px; }
.aviso-ok { background-color: rgba(110, 200, 140, 0.12); border-width: 1px; border-color: rgba(110, 200, 140, 0.4); border-radius: 3px; color: var(--verde); padding: 8px 12px; margin-bottom: 12px; white-space: normal; font-size: 14px; }
.pie { font-size: 11px; color: var(--texto-apagado); -unity-text-align: middle-center; margin-top: 16px; }

/* Partidas */
.partida { flex-direction: column; align-items: stretch; padding: 10px 12px; margin-bottom: 8px; background-color: rgba(34, 26, 18, 0.6); border-width: 1px; border-color: var(--bronce-osc); border-left-width: 3px; border-radius: 2px; }
.partida:hover { border-color: var(--bronce); }
.partida--elegida { border-color: var(--oro); background-color: rgba(216, 184, 120, 0.12); }
.partida-nombre { font-size: 17px; -unity-font-style: bold; color: var(--oro-claro); -unity-text-align: middle-left; }
.partida-heroe { font-size: 14px; color: var(--pergamino); -unity-text-align: middle-left; margin-top: 4px; }
.partida-detalle { font-size: 12px; color: var(--texto-2); -unity-text-align: middle-left; }
.vacio { color: var(--texto-apagado); font-size: 14px; -unity-text-align: middle-center; padding: 16px; }

/* Pantalla de carga */
.carga { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--tinta); transition-property: opacity; transition-duration: 0.45s; }
.carga--saliendo { opacity: 0; }
.carga-imagen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; opacity: 0; transition-property: opacity, scale; transition-duration: 0.6s, 16s; }
.carga-imagen--cargada { opacity: 1; scale: 1.06 1.06; }
.carga-consejo { position: absolute; left: 0; right: 0; bottom: 0; height: 25%; min-height: 170px; padding: 0 14% 62px 14%; align-items: center; justify-content: center; background-color: rgba(14, 10, 6, 0.78); }
.carga-kicker { font-size: 12px; -unity-font-style: bold; letter-spacing: 6px; color: var(--oro); margin-bottom: 8px; }
.carga-texto { font-size: 19px; color: var(--pergamino); -unity-text-align: middle-center; white-space: normal; max-width: 760px; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); }
.carga-pie { position: absolute; left: 25%; right: 25%; bottom: 20px; align-items: center; }
.carga-titulo { font-size: 13px; letter-spacing: 3px; color: var(--oro-claro); margin-bottom: 7px; }
.carga-barra { width: 100%; height: 8px; border-width: 1px; border-color: var(--bronce-osc); border-radius: 4px; background-color: rgba(0, 0, 0, 0.6); overflow: hidden; }
.carga-barra-relleno { height: 100%; width: 0; background-color: var(--oro); transition-property: width; transition-duration: 0.25s; }

/* Pantalla de la sesión viva (provisional hasta el mapa) */
.barra-arriba { position: absolute; left: 0; top: 0; right: 0; height: 52px; flex-direction: row; align-items: center; padding: 0 14px; background-color: var(--marco-panel); border-bottom-width: 2px; border-color: var(--bronce-osc); }
.barra-arriba .titulo { font-size: 17px; letter-spacing: 4px; -unity-text-align: middle-left; flex-grow: 1; }
.barra-arriba Button { margin-left: 8px; }
.diagnostico { position: absolute; left: 24px; top: 72px; right: 24px; bottom: 24px; flex-direction: row; }
.columna { flex-grow: 1; flex-basis: 0; margin-left: 8px; margin-right: 8px; }
.ficha { flex-direction: row; justify-content: space-between; padding: 6px 10px; margin-bottom: 4px; background-color: var(--marco-bg-alt); border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; }
.ficha-etiqueta { color: var(--texto-apagado); font-size: 13px; }
.ficha-valor { color: var(--oro-claro); font-size: 13px; -unity-text-align: middle-right; white-space: normal; flex-shrink: 1; }
.reloj { font-size: 30px; color: var(--oro-claro); -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 6px; }
.insignia { background-color: var(--terracota); color: var(--pergamino); border-radius: 9px; padding: 0 6px; font-size: 12px; margin-left: 6px; -unity-font-style: bold; }

/* Avisos: el aviso flotante arriba al centro, y el panel con su historial */
.toast { position: absolute; top: 64px; left: 30%; right: 30%; padding: 10px 18px; background-color: var(--marco-bg-alt); border-width: 2px; border-color: var(--bronce); border-radius: 3px; color: var(--pergamino); -unity-text-align: middle-center; white-space: normal; font-size: 15px; transition-property: opacity; transition-duration: 0.3s; }
.toast--peligro { border-color: var(--terracota); color: var(--rojo-claro); }
.toast--oculto { opacity: 0; }
.panel-avisos { position: absolute; top: 60px; right: 12px; bottom: 12px; width: 420px; }
.panel-avisos .placa-filete { flex-grow: 1; padding: 14px 16px; }
.avisos-cab { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; margin-bottom: 4px; }
.avisos-seccion-titulo { font-size: 14px; -unity-font-style: bold; color: var(--oro); background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; -unity-text-align: middle-left; }
.avisos-urgentes .avisos-seccion-titulo { color: var(--terracota); }
.aviso { flex-direction: row; padding: 7px 10px; margin-bottom: 4px; background-color: rgba(34, 26, 18, 0.7); border-width: 1px; border-color: var(--bronce-osc); border-left-width: 3px; border-radius: 2px; }
.aviso--nuevo { border-left-color: var(--oro); }
.aviso--urgente { border-left-color: var(--terracota); }
.aviso-cuerpo { flex-grow: 1; flex-shrink: 1; }
.aviso-titulo { font-size: 13px; -unity-font-style: bold; color: var(--oro-claro); }
.aviso-texto { font-size: 13px; color: var(--pergamino); white-space: normal; }
.aviso-cuando { font-size: 11px; color: var(--texto-apagado); }
.aviso-borrar { background-color: rgba(0, 0, 0, 0); border-width: 0; color: var(--texto-apagado); font-size: 16px; width: 22px; padding: 0; }
.aviso-borrar:hover { color: var(--rojo-claro); }

/* El cuadro de confirmación del juego */
.dialogo-velo { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10, 8, 5, 0.65); align-items: center; justify-content: center; }
.dialogo { width: 460px; }
.dialogo .placa-filete { padding: 18px 20px 16px 20px; }
.dialogo-titulo { font-size: 17px; -unity-font-style: bold; color: var(--oro-claro); letter-spacing: 1px; margin-bottom: 8px; }
.dialogo-texto { font-size: 15px; color: var(--pergamino); white-space: normal; margin-bottom: 16px; }
.dialogo-botones { flex-direction: row; justify-content: flex-end; }
.dialogo-botones Button { margin-left: 8px; }
.dialogo-botones .boton-primario { margin-top: 0; height: 36px; padding: 0 18px; }

/* Las letras: Cinzel para lo que en la guía va con --fuente-titulo; Inter seminegrita para el resto de lo destacado. */
.titulo, .kicker, .boton-primario, .carga-kicker, .carga-titulo, .dialogo-titulo, .partida-nombre, .reloj {
    -unity-font: url("Fuentes/Cinzel-SemiBold.ttf"); -unity-font-definition: initial; -unity-font-style: normal;
}
.pestana, .aviso-titulo, .insignia, .avisos-seccion-titulo { -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; -unity-font-style: normal; }

/* El mapa de mundo: nombres sobre el mapa, la ficha de lo seleccionado, la lista bajo el clic y el aviso de dentro (BronzeAgeClient:
   `mundo3d.css`, `.mapa-seleccion`, `.eleccion-clic`). */
.nombre-mapa { position: absolute; translate: -50% -100%; flex-direction: row; align-items: center; padding: 2px 7px; background-color: rgba(10, 14, 23, 0.78); border-left-width: 3px; border-radius: 2px; }
.nombre-mapa > Label { font-size: 12px; color: rgb(255, 255, 255); padding: 0; margin: 0; }
.nombre-mapa--nodo > Label { font-size: 11px; color: rgb(220, 214, 200); }
.nombre-mapa--tenue { opacity: 0.6; }
.panel-mapa-arriba { position: absolute; top: 120px; left: 30%; right: 30%; }
.fila-mapa { flex-direction: row; align-items: center; }
.ficha-mapa { position: absolute; right: 12px; bottom: 12px; width: 340px; }
.lista-fila { flex-direction: column; align-items: stretch; padding: 7px 10px; margin-bottom: 4px; background-color: rgba(34, 26, 18, 0.7); border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; }
.lista-fila:hover { border-color: var(--bronce); }
.ficha-mapa .boton-secundario { margin-bottom: 6px; height: 32px; }

/* Crear el héroe: la lista de campamentos a la izquierda y la ficha con el nombre a la derecha, sobre el mapa. */
.panel-izquierda { position: absolute; left: 12px; top: 64px; bottom: 12px; width: 300px; }
.panel-derecha { position: absolute; right: 12px; top: 64px; bottom: 12px; width: 420px; }
.panel-relleno { flex-grow: 1; padding: 14px 16px; }
.fila-envuelta { flex-direction: row; flex-wrap: wrap; }
.fila-envuelta > Button { margin: 0 6px 6px 0; }
.campamento { flex-direction: column; align-items: stretch; padding: 8px 10px; margin-bottom: 6px; background-color: rgba(34, 26, 18, 0.7); border-width: 1px; border-color: var(--bronce-osc); border-left-width: 3px; border-radius: 2px; }
.campamento:hover { border-color: var(--bronce); }
.campamento--elegido, .clase--elegida { border-color: var(--oro); background-color: rgba(216, 184, 120, 0.16); }
.clase--elegida { color: var(--oro-claro); }
.campamento--comparado { border-left-color: var(--oro-claro); }
/* La tarjeta es un botón sin aspecto de botón (para elegir) y debajo la casilla de comparar. */
.campamento-boton { flex-direction: column; align-items: stretch; margin: 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-text-align: middle-left; }
.campamento-recomendado { color: var(--oro); font-size: 12px; margin-left: 6px; -unity-text-align: middle-left; }
.campamento-comparar { margin: 4px 0 0 0; font-size: 12px; color: var(--texto-2); }
/* Comparar dos campamentos: una fila por dato, el mejor en oro. */
.comparar-fila { flex-direction: row; align-items: center; justify-content: space-between; padding: 3px 0; border-bottom-width: 1px; border-color: rgba(107, 74, 41, 0.5); }
.comparar-titulo { width: 30%; color: var(--texto-2); font-size: 12px; white-space: normal; }
.comparar-valor { width: 35%; white-space: normal; font-size: 13px; }
.comparar-gana { color: #9fe0a0; background-color: rgba(39, 174, 96, 0.12); -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; -unity-font-style: normal; }
.puntos { color: var(--oro); letter-spacing: 2px; }

/* El interior de un campamento (paso 4): la cabecera y la ayuda de abajo; la ventana «Salir al mundo». */
.ayuda-interior { position: absolute; left: 14px; bottom: 10px; font-size: 12px; color: var(--pergamino); background-color: rgba(20, 15, 10, 0.6); padding: 4px 8px; border-radius: 2px; }
.salida { width: 520px; max-height: 90%; }
.salida-fila { flex-direction: row; align-items: center; justify-content: space-between; padding: 3px 0; }
.salida-fila IntegerField { width: 110px; margin: 0; }
.salida-seccion { margin-bottom: 10px; }
.cartel-interior { position: absolute; left: 35%; right: 35%; bottom: 18%; -unity-text-align: middle-center; font-size: 18px; color: var(--oro-claro); background-color: rgba(20, 15, 10, 0.8); border-width: 1px; border-color: var(--bronce-osc); padding: 8px 14px; border-radius: 2px; }
.panel-campamento { width: 640px; max-height: 88%; }
.panel-campamento .salida-fila Button { margin-left: 8px; }
/* Los campos de número de las ventanas (cantidad, carga): legibles sobre la placa. */
.dialogo .unity-base-text-field__input { color: var(--pergamino); background-color: rgba(10, 8, 5, 0.7); border-color: var(--bronce-osc); -unity-font: url("Fuentes/Inter-Regular.ttf"); -unity-font-definition: initial; }

/* Los iconos del prototipo (`IconosDelMundo`; BronzeAgeClient: style.css). */
.con-icono { flex-direction: row; align-items: center; }
.con-icono > .icono { margin-right: 6px; }
/* La pieza de un recurso (`.asent-recurso`): su emoji y la cifra. */
.chip-recurso {
    flex-direction: row; align-items: center; padding: 2px 6px; margin: 0 4px 4px 0;
    border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; background-color: rgba(0, 0, 0, 0.28);
}
.chip-recurso > .icono { margin-right: 4px; }
.chip-recurso-cifra { color: var(--oro-claro); font-size: 13px; }
.chip-recurso--falta .chip-recurso-cifra { color: #e2675a; }
/* Un chip de dato (`.obra-chip`): píldora oscura. */
.chip { flex-direction: row; align-items: center; padding: 2px 9px; margin: 0 6px 4px 0; border-width: 1px; border-color: var(--bronce-osc); border-radius: 9px; background-color: rgba(0, 0, 0, 0.35); }
.chip > .icono { margin-right: 4px; }
/* El título de una ventana con su icono (`htmlTituloDeParte`). */
.titulo-con-icono { flex-direction: row; align-items: center; }
.titulo-con-icono > .icono { margin-right: 10px; }
/* La cabecera de un carril (`.ta-carril`): el icono del edificio y su nombre en oro. */
.carril { flex-direction: row; align-items: center; margin-top: 14px; margin-bottom: 6px; }
.carril > .icono { margin-right: 8px; }
/* El mercado del campamento (`.mercado-bien`, `.mercado-total`). */
.mercado-bien { flex-direction: row; align-items: center; min-width: 150px; padding: 5px 9px; margin: 0 6px 6px 0; background-color: #1d1610; border-width: 1px; border-color: var(--bronce-osc); border-radius: 2px; }
.mercado-bien:hover { border-color: var(--bronce); }
.mercado-bien.clase--elegida { border-color: var(--oro); background-color: rgb(58, 44, 26); }
.mercado-bien > .icono { margin-right: 8px; }
.mercado-bien-nombre { color: var(--pergamino); font-size: 14px; -unity-text-align: middle-left; }
.mercado-bien-detalle { color: var(--texto-apagado); font-size: 11px; -unity-text-align: middle-left; }
.mercado-total { flex-direction: row; margin-top: 8px; }
.mercado-total-caja { flex-grow: 1; flex-basis: 0; padding: 5px 8px; margin-right: 6px; border-width: 1px; border-color: var(--bronce-osc); background-color: rgba(0, 0, 0, 0.25); }
.mercado-total-titulo { font-size: 11px; color: var(--texto-apagado); }
.mercado-total-valor { font-size: 17px; color: var(--oro-claro); }
.mercado-hecho { color: #9ad07a; }
/* La cifra de la carga del carro, en rojo si no cabe (`[data-carga-total].excedido`). */
.excedido { color: #e8806f; }
/* La placa «Tu almacén» del interior (`.asent-pie-grupo`). */
.placa-almacen { position: absolute; left: 12px; bottom: 34px; max-width: 60%; padding: 6px 8px 2px 8px; background-color: var(--marco-bg-alt); border-width: 1px; border-color: var(--bronce); border-top-color: var(--oro); border-radius: 3px; }
.placa-almacen-titulo { font-size: 10px; color: var(--oro); letter-spacing: 3px; margin-bottom: 4px; }
.cabecera-icono { margin-right: 12px; }
/* Las filas de nodos del mapa con su icono. */
.nombre-mapa-icono { width: 16px; height: 16px; margin-right: 5px; flex-shrink: 0; }
.lista-fila-cab { flex-direction: row; align-items: center; }
.lista-fila-icono { width: 26px; height: 26px; border-radius: 13px; margin-right: 8px; align-items: center; justify-content: center; background-color: var(--tinta); border-width: 1px; border-color: var(--bronce-osc); }
.lista-fila-texto { flex-shrink: 1; flex-grow: 1; }
/* «Nace tu héroe»: el edificio militar, las tropas del primer día y los yacimientos (`.elegir-*`). */
.elegir-edificio { width: 44px; height: 44px; align-items: center; justify-content: center; border-width: 1px; border-color: #4a3722; border-radius: 6px; margin-right: 8px; }
.elegir-tropa { flex-direction: row; align-items: center; padding: 2px 9px 2px 3px; margin: 0 6px 6px 0; border-radius: 14px; background-color: #241b12; border-width: 1px; border-color: var(--bronce-osc); }
.elegir-tropa > .icono { margin-right: 5px; }
.elegir-tropa > Label { font-size: 12px; color: var(--pergamino); }
.elegir-tropa--despues { opacity: 0.45; }
.chip-texto { color: var(--oro-claro); font-size: 12px; }
.carril-texto { color: var(--oro); font-size: 12px; -unity-font-style: bold; letter-spacing: 5px; }
.boton-texto { color: #201509; -unity-font-style: bold; letter-spacing: 2px; font-size: 14px; }
.boton-primario .chip-recurso { background-color: rgba(20, 14, 8, 0.78); }
.bandidos-nivel { flex-direction: row; align-items: center; margin-bottom: 8px; }
.bandidos-nivel-punto { width: 14px; height: 14px; margin-right: 5px; border-width: 1px; border-color: var(--terracota); border-radius: 7px; }
.bandidos-nivel-punto--on { background-color: var(--terracota); }
.bandidos-nivel .campo-ayuda { margin: 0 0 0 6px; }
.ficha .con-icono { flex-shrink: 0; margin-right: 10px; }
.ficha .con-icono > .icono { margin-right: 6px; }
.comparar-nodo { font-size: 13px; margin-right: 8px; }
.comparar-gana .comparar-nodo { color: #9fe0a0; } /* `td.gana` del prototipo */
/* Un botón con su glifo (`.puerta-boton-icono`). */
.boton-con-glifo { flex-direction: row; align-items: center; justify-content: center; }
.boton-con-glifo > .icono { margin-right: 8px; }
.boton-con-glifo-texto { padding: 0; margin: 0; color: var(--pergamino); font-size: 14px; }
.boton-con-glifo:hover > .boton-con-glifo-texto { color: var(--oro-claro); }
/* El error de acceso y partidas con su ⚠️ (`.error-banner`). */
.error-fila { flex-direction: row; align-items: flex-start; background-color: rgba(191, 82, 51, 0.18); border-width: 1px; border-color: var(--terracota); border-radius: 3px; padding: 8px 12px; margin-bottom: 12px; }
.error-texto { color: var(--rojo-claro); white-space: normal; font-size: 14px; flex-shrink: 1; padding: 0; margin: 0; }
.icono-aviso { width: 16px; height: 16px; margin: 1px 8px 0 0; flex-shrink: 0; background-image: resource("MundoUI/Iconos/glifo/aviso"); }
/* Las piezas de tropa de Conquest (`PiezasDeTropa`; gemelas de Squad_Icon, Squad_option y las estrellas de SquadDetailPanel). */
.tropa-mini { flex-shrink: 0; margin-right: 8px; }
.tropa-mini-fondo, .tropa-mini-icono { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.tropa-mini-linea { position: absolute; left: 0; right: 0; bottom: 0; }
.tropa-tarjeta { flex-shrink: 0; margin: 0 8px 8px 0; }
.tropa-tarjeta-capa { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.tropa-tarjeta-franja { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 6px 3px 6px; background-color: rgba(56, 56, 56, 0.6); }
.tropa-tarjeta-linea { position: absolute; left: 0; right: 0; bottom: 0; }
.tropa-tarjeta-marca { position: absolute; left: -1px; top: -1px; right: -1px; bottom: -1px; background-color: rgba(255, 255, 255, 0.11); display: none; }
.tropa-tarjeta--elegida > .tropa-tarjeta-marca { display: flex; }
.tropa-tarjeta-liderazgo-icono { margin-left: 2px; background-image: url("/Assets/Art/UI/units/leadership.png"); -unity-background-scale-mode: scale-to-fit; }
.tropa-tarjeta-datos { flex-direction: row; align-items: center; }
.tropa-tarjeta-liderazgo { flex-direction: row; align-items: center; margin-left: 6px; }
.tropa-tarjeta-nivel, .tropa-tarjeta-cifra, .tropa-tarjeta-hombres { color: rgb(255, 255, 255); font-size: 16px; -unity-font-style: bold; padding: 0; margin: 0; -unity-font: url("Fuentes/Inter-SemiBold.ttf"); -unity-font-definition: initial; }
.tropa-estrellas { flex-direction: row; }
.tropa-estrella { padding: 0; margin: 0; -unity-text-align: middle-left; }
/* Una tropa con lo que se hace con ella debajo (las del campamento y la salida). */
.tropa-con-accion { width: 150px; margin: 0 10px 12px 0; }
.tropa-con-accion > .tropa-tarjeta { margin: 0 0 6px 0; }
.tropa-con-accion > Label { white-space: normal; }
.tropa-con-accion > Button { margin: 4px 0 0 0; }
/* La casilla «Sale» bajo la tarjeta: sin el ancho mínimo de la etiqueta de los campos (empujaba la casilla fuera de la columna). */
.tropa-con-accion > Toggle { margin: 2px 0 0 0; }
.tropa-con-accion .unity-base-field__label { min-width: 0; margin-right: 8px; }
